# Example coil.toml — copy this to your project root as `coil.toml`.
#
# `coil.toml` is the project manifest. It declares the directories the
# compiler searches for `use foo::bar::baz;` imports, an optional
# explicit entry point, and optional package / dependency metadata
# for the `spool` library dependency manager.
#
# Naming:
#   spool          — library deps (install / add / update); Coil userland
#   coil package   — embed a .hyc into a runner executable (unrelated)

# Optional package identity (required keys when the section is present).
# [package]
# name = "my_app"
# version = "0.1.0"
# coil = ">=0.1.0"                 # optional engine range; omit = no constraint
# include = "./hooks/include.sh"    # optional; relative to this package checkout

[module]
# Search roots for `use` resolution. Each path is relative to the
# directory containing this `coil.toml` file. The compiler searches
# the roots in order; the first file that exists wins.
# Include coil-stdlib `src/` (sibling clone or `.deps/coil-stdlib/src`)
# to import `http::client`, etc.
# After `spool install`, include `"./.spool/deps"` for managed library deps.
# For unprefixed stdlib imports via spool, use `"./.spool/deps/stdlib"`.
roots = ["./src", "./vendor", "../coil-stdlib/src"]

# The default roots (when no `coil.toml` exists) are just `["src"]`.

[entry]
# Optional: the entry-point file. When set, `coil` / `coil compile`
# with no file argument use this path (relative to the project root).
# If omitted, you must pass the entry on the command line
# (e.g. `coil examples/foo.hy`).
# file = "./src/main.hy"

# --------------------------------------------------------------------------
# Dependencies (`spool`)
# --------------------------------------------------------------------------
#
# Declared for the `spool` package manager. The compiler parses and
# stores these entries but does not fetch or inject roots — add
# `"./.spool/deps"` to `[module].roots` after install so `use`
# resolves packages by short name (never by git URL).
#
# [dependencies]
# http = { git = "https://github.com/coil-lang/http.git", version = "^0.2" }
# local_http = { path = "../local-http" }
# `trusted` is a bool on that git/path row (default false). `true` / `false`
# parse; any other type is a parse error. Meaning: that dep skips native
# sha256 only, and only when its stem is also on `[ffi] allow`.
# Not git content_hash, not hooks, not engine, never dload("c").
# crypto = { git = "https://github.com/ardax-corp/coil-crypto.git", trusted = true }

# --------------------------------------------------------------------------
# Lifecycle scripts (current project only)
# --------------------------------------------------------------------------
#
# [scripts]
# pre_install = "./scripts/pre-install.sh"
# post_install = "./scripts/post-install.sh"
# pre_update = "./scripts/pre-update.sh"
# post_update = "./scripts/post-update.sh"

# --------------------------------------------------------------------------
# FFI (`dload`)
# --------------------------------------------------------------------------
#
# The gate looks at the filename stem. An absolute path is not a bypass:
# `dload("/abs/libplugin.so")` is still stem `plugin`.
# `[ffi] search_paths` locates files; it is not a grant.
#
# `Stream.attach` installs a C vtable on any Stream. That is off by
# default (`PermissionDenied`). Opt in with `allow_attach = true`.
# `allow` for `dload` does not grant attach.
#
# Every `dload` stem needs `[ffi] allow`, then a matching lock
# `[[package.native]] sha256` or `trusted = true` on that dep.
# `crypto`, `tls`, `regex`, and `time` follow the same rule; they have
# no skip. A stem without allow is `LibraryDenied`. Allow plus
# `trusted` when the file is missing is `LibraryNotFound`.
#
# coil-crypto bootstrap is allow plus trusted (or a lock hash):
#
#   [ffi]
#   allow = ["crypto"]
#   [dependencies]
#   crypto = { git = "https://github.com/ardax-corp/coil-crypto.git", trusted = true }
#
# Extra stems use the same rule. Allow without a hash, a hash without
# allow, or a mismatch is `LibraryDenied`.
#
# `dload("c")` / libc aliases stay deny even if listed in `allow` or a
# lock pin, and even if a dependency row is `trusted`.
#
# [ffi]
# search_paths = ["./.spool/native"]
# allow = ["plugin"]
# allow_attach = true

# --------------------------------------------------------------------------
# Discovery algorithm
# --------------------------------------------------------------------------
#
# Given `use foo::bar::baz;` and the roots above, the compiler
# searches, in order:
#
#   1. ./src/foo/bar/baz.hy          (one-item-per-file)
#   2. ./src/foo/bar.hy              (item inside module file)
#   3. ./vendor/... then ../coil-stdlib/src/...
#
# The first file that exists wins. The file's namespace is the path
# RELATIVE to the matching root, with the extension stripped and
# `/` replaced with `::`. So `./src/foo/bar/baz.hy` lives in
# namespace `foo::bar::baz`, and its top-level `fn helper()` is
# bytecode-named `foo::bar::baz::helper`. A top-level `fn baz` in
# `./src/foo/bar.hy` is named `foo::bar::baz`.
#
# --------------------------------------------------------------------------
# Glob imports
# --------------------------------------------------------------------------
#
# `use foo::bar::*;` loads `foo/bar.hy` and brings every top-level
# item from that file into scope by its bare name:
#
#     use foo::bar::*;
#     fn main() {
#         some_helper();   // from foo/bar.hy
#     }
#
# Glob imports are file-scoped — they do not reach into `foo/bar/`.
#
# --------------------------------------------------------------------------
# Brace-group imports
# --------------------------------------------------------------------------
#
# Import several items from the same module in one statement:
#
#     use math::{add, mul as product};
#
# This desugars to `use math::add;` + `use math::mul as product;`.
# When `math.hy` exports both functions (and `math/add.hy` does not
# exist), both resolve to the same module file.
#
# --------------------------------------------------------------------------
# Aliasing
# --------------------------------------------------------------------------
#
# `use foo::bar as baz;` brings `bar` into scope as `baz`. Calls
# to `baz()` resolve to the qualified name for that item.
#
# `use builtins::core::ffi::dload as loadlib;` lets the user rename
# a builtin to avoid conflicts (e.g., when a user function is also
# called `dload`).
#
# --------------------------------------------------------------------------
# Accepted keys
# --------------------------------------------------------------------------
#
# Unknown sections and keys are parse errors. Accepted today
# (see coil-website src/content/docs/references/project-config.md,
#  site route /docs/references/project-config):
#
#   [module]
#   roots                    # search directories for `use` resolution
#
#   [entry]
#   file                     # optional entry-point path
#
#   [env]
#   allow_exec = true        # opt-in: env::exec only (default false). Not FFI system/execve.
#   allow_exit = true        # opt-in: env::exit (default false). Independent of allow_exec.
#   allow_ffi_exec = true    # opt-in: FFI system/execve resolve (default false). Independent of allow_exec.
#
#   [ffi]
#   search_paths             # extra dirs for FFI library lookup (not a grant)
#   allow                    # dload stems; each also needs a lock sha256 or trusted
#   allow_attach             # opt-in: Stream.attach C vtables (default false)
#
#   [package]
#   name / version           # package identity for spool
#   coil                     # optional engine range; omit = no constraint
#   include                  # optional include-hook; relative to this package
#
#   [scripts]
#   pre_install / post_install / pre_update / post_update
#
#   [dependencies]
#   name = { git = "…", version = "…", rev = "…" } | { path = "…" }
#   trusted                  # optional bool, default false; `true`/`false` only
#                            # native sha256 skip on that dep only, if also on
#                            # `[ffi] allow` (including crypto/tls/regex/time).
#                            # Not content_hash / hooks / engine / dload("c")
#
# Compiler builtins (prelude, ffi, …) are virtual modules and are
# not configured here. Extra disk search paths belong in `roots`.
