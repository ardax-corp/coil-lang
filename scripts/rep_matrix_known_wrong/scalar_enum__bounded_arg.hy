// Known crash: #1903: exit -6: internal compiler error: 2 bodies fell back to the HIR stack lowering: `KBox::put$inst$string_Lvl` (no MIR from HIR: push receiver), `KBox::get$inst$string_Lvl`
// @output high\nlow\n
//
// Representation matrix cell scalar_enum x bounded_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[repr(int)]
#[derive(Eq, Hash, Show)]
enum Lvl {
    Low = 1,
    High = 2,
}

fn say(Lvl v) -> string {
    return match v {
        Lvl::Low => "low",
        Lvl::High => "high",
    };
}

class KBox<K, V> {
    pub ks: Vec<K>,
    pub vs: Vec<V>,
}

impl KBox<K: Eq, V> {
    pub fn put(K k, V x) {
        self.ks.push(k);
        self.vs.push(x);
    }

    pub fn get(K k) -> V {
        let i = 0;
        while i < self.ks.len() - 1 && self.ks[i] != k {
            i = i + 1;
        }
        return self.vs[i];
    }
}

fn kboxed(Lvl x) -> KBox<string, Lvl> {
    let ks: Vec<string> = Vec::new();
    let vs: Vec<Lvl> = Vec::new();
    let c = new KBox(ks, vs);
    c.put("k", x);
    return c;
}

fn main() {
    let a: Lvl = Lvl::High;
    let b: Lvl = Lvl::Low;
    println(say(kboxed(a).get("k")))?;
    println(say(kboxed(b).get("k")))?;
}
