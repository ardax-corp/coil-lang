// Known crash: #1903: exit -6: internal compiler error: 1 body fell back to the HIR stack lowering: `untupled` (no MIR from HIR: pair operand)
// @output high\nlow\n
//
// Representation matrix cell scalar_enum x tuple_item: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[repr(int)]
#[derive(Eq, Hash, Show)]
enum Lvl {
    Low = 1,
    High = 2,
}

fn say(Lvl v) -> string {
    return match v {
        Lvl::Low => "low",
        Lvl::High => "high",
    };
}

fn tupled<W>(W w) -> (W, int) {
    return (w, 1);
}

fn untupled(Lvl x) -> Lvl {
    let (y, _) = tupled(x);
    return y;
}

fn main() {
    let a: Lvl = Lvl::High;
    let b: Lvl = Lvl::Low;
    println(say(untupled(a)))?;
    println(say(untupled(b)))?;
}
