// Known crash: #1903: exit -6: internal compiler error: 2 bodies fell back to the HIR stack lowering: `first` (no MIR from HIR: index), `Box::put$inst$Lvl` (no MIR from HIR: push receiver)
// @output high\nlow\n
//
// Representation matrix cell scalar_enum x vec_field_local: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[repr(int)]
#[derive(Eq, Hash, Show)]
enum Lvl {
    Low = 1,
    High = 2,
}

fn say(Lvl v) -> string {
    return match v {
        Lvl::Low => "low",
        Lvl::High => "high",
    };
}

class Box<V> {
    pub v: V,
    pub vs: Vec<V>,
}

impl Box<V> {
    pub fn put(V x) {
        self.v = x;
        self.vs.push(x);
    }

    pub fn get() -> V {
        return self.v;
    }

    pub fn at(int i) -> V {
        return self.vs[i];
    }
}

fn boxed(Lvl x) -> Box<Lvl> {
    let vs: Vec<Lvl> = Vec::new();
    let c = new Box(x, vs);
    c.put(x);
    return c;
}

fn first(Vec<Lvl> w) -> Lvl {
    return w[0];
}

fn main() {
    let a: Lvl = Lvl::High;
    let b: Lvl = Lvl::Low;
    println(say(first(boxed(a).vs)))?;
    println(say(first(boxed(b).vs)))?;
}
