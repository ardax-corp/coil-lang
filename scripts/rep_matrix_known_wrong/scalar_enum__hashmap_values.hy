// @output high\nlow\n
//
// Representation matrix cell scalar_enum x hashmap_values: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

#[repr(int)]
#[derive(Eq, Hash, Show)]
enum Lvl {
    Low = 1,
    High = 2,
}

fn say(Lvl v) -> string {
    return match v {
        Lvl::Low => "low",
        Lvl::High => "high",
    };
}

fn valued(Lvl x) -> Lvl {
    let m: HashMap<string, Lvl> = HashMap::new();
    m.insert("k", x);
    return m.values()[0];
}

fn main() {
    let a: Lvl = Lvl::High;
    let b: Lvl = Lvl::Low;
    println(say(valued(a)))?;
    println(say(valued(b)))?;
}
