// Coil twins of host natives, for native code only (module `native_twins`).
//
// The VM keeps these natives in the runtime. Native code calls the twin
// instead (`compiler/src/mir/native_twins.rs` maps each host id to its
// twin), so a native build does not need the native in `libcoil_rt`.
// A twin returns exactly what its native returns, word for word: VM code
// and native code share values (a string's hash keys a map either side).
// The compiler embeds this module only while a native capture is open.

use string::format;

/// Twin of `hash_string` (host id 67): the string's 32-bit FNV-1a hash of
/// its bytes, as the runtime's `ObjString::hash`.
fn hash_string(string s) -> int {
    let n = s.len();
    let h = 2166136261;
    let i = 0;
    while i < n {
        h = ((h ^ (s[i] as int)) * 16777619) & 4294967295;
        i = i + 1;
    }
    return h;
}

/// Twin of `string_compare` (host id 162): the sign of the byte order of
/// `a` against `b` (`-1`, `0` or `1`), as `<` on two strings takes it.
fn string_compare(string a, string b) -> int {
    let n = a.len();
    let m = b.len();
    let i = 0;
    while i < n && i < m {
        let x = a[i] as int;
        let y = b[i] as int;
        if x < y {
            return -1;
        }
        if x > y {
            return 1;
        }
        i = i + 1;
    }
    if n < m {
        return -1;
    }
    if n > m {
        return 1;
    }
    return 0;
}

/// Helper of the native `Vec::insert` expansion (`mir/native_expand.rs`):
/// the panic message of an out-of-bounds `index`, as the runtime's
/// `vec_insert` words it.
fn vec_insert_oob(int index, int len) -> string {
    return format("Vec::insert: index %i out of bounds (len %i)", index, len);
}
