// Doc stubs for the builtin `gc` module (hover docs; never compiled).

/// A strong pin that keeps a value alive, made by `root`.
///
/// While the `Root` is alive (until `unroot`), its value stays alive, even
/// when nothing else refers to it. The usual use is FFI:
/// pin a Coil buffer or callback before handing its address to C code that
/// keeps it. Read the value with `get`, release it with `unroot`. A `Root`
/// cannot be sent to another thread.
///
/// # Examples
///
/// ```
/// use gc::{root, get, Root};
/// # use tests::assert;
/// let pin: Root<Vec<int>> = root(Vec::from([1, 2, 3]));
/// let n = match get(pin) {
///     Option::Some(v) => v.len(),
///     Option::None => 0,
/// };
/// assert!(n == 3);
/// ```
class Root<T> {}

/// A handle that refers to a value without keeping it alive, made by `weak`.
///
/// `upgrade` returns the value while something else still keeps it alive,
/// and `None` once it was freed. Use it for registries and
/// caches that must not extend lifetimes. A `Weak` cannot be sent to
/// another thread.
///
/// # Examples
///
/// ```
/// use gc::{weak, upgrade, Weak};
/// # use tests::assert;
/// let data = Vec::from([1, 2]);
/// let w: Weak<Vec<int>> = weak(data);
/// let alive = match upgrade(w) {
///     Option::Some(v) => v.len() == 2,
///     Option::None => false,
/// };
/// assert!(alive && data.len() == 2);
/// ```
class Weak<T> {}

/// Pins `value` so it stays alive while the returned `Root` does.
///
/// # Examples
///
/// ```
/// use gc::{root, get};
/// # use tests::assert;
/// let pin = root("kept");
/// assert!(match get(pin) { Option::Some(s) => s == "kept", Option::None => false });
/// ```
fn root<T>(T value) -> Root<T> {}

/// Returns the pinned value, leaving the pin in place.
///
/// Returns `None` after `unroot` has released the pin.
///
/// # Examples
///
/// ```
/// use gc::{root, get, unroot};
/// # use tests::assert;
/// let pin = root(7);
/// assert!(match get(pin) { Option::Some(n) => n == 7, Option::None => false });
/// let _ = unroot(pin);
/// assert!(match get(pin) { Option::Some(_) => false, Option::None => true });
/// ```
fn get<T>(Root<T> pin) -> Option<T> {}

/// Releases the pin and returns the value it held.
///
/// After this the `Root` no longer keeps the value alive, even if the
/// `Root` itself is still reachable. A second `unroot` (or `get`) returns
/// `None`.
///
/// # Examples
///
/// ```
/// use gc::{root, unroot};
/// # use tests::assert;
/// let pin = root("once");
/// assert!(match unroot(pin) { Option::Some(s) => s == "once", Option::None => false });
/// assert!(match unroot(pin) { Option::Some(_) => false, Option::None => true });
/// ```
fn unroot<T>(Root<T> pin) -> Option<T> {}

/// Makes a handle to `value` that does not keep it alive.
///
/// A `weak` of an `Option` or a `Result` of a heap value refers to the heap
/// object it holds. A value with no object of its own is refused (`E0119`):
/// a one-word value (`int`, `float`, `bool`, `byte`, `()`, a scalar enum), a
/// two-word value (an `Option<int>`, a `Result<int, E>`, an `(int, float)`,
/// a range, a small enum) and a readonly class instance are held in their
/// words, with no object to observe. This holds through generics too, at the
/// call that sets a type parameter to such a type.
///
/// # Examples
///
/// ```
/// use gc::{weak, upgrade};
/// # use tests::assert;
/// let v = Vec::from([5]);
/// let w = weak(v);
/// // `v` is used below, so it is still alive here.
/// assert!(match upgrade(w) { Option::Some(u) => u[0] == 5, Option::None => false });
/// assert!(v.len() == 1);
/// ```
fn weak<T>(T value) -> Weak<T> {}

/// Returns the value while it is still alive, `None` once it was freed.
///
/// A weak referent is cleared when nothing strong (a variable, a field, a
/// `Root`, ...) refers to it any more: at its last owner's release, or when
/// the cycle collector frees the cycle it is in. Class `drop`
/// finalizers run before weaks are cleared and can still upgrade a weak to
/// the object being dropped.
///
/// # Examples
///
/// ```
/// use gc::{weak, upgrade, collect, Weak};
/// # use tests::assert;
/// fn make() -> Weak<Vec<int>> {
///     let v = Vec::from([1, 2, 3]);
///     // `v`, the only strong reference, ends with this call.
///     return weak(v);
/// }
///
/// fn main() {
///     let w = make();
///     collect();
///     let gone = match upgrade(w) {
///         Option::Some(_) => false,
///         Option::None => true,
///     };
///     assert!(gone);
/// }
/// ```
fn upgrade<T>(Weak<T> handle) -> Option<T> {}

/// Returns the size of the managed heap in bytes.
///
/// This counts only the memory of Coil values: not native libraries, stacks
/// or other process memory.
///
/// # Examples
///
/// ```
/// use gc::{heap_bytes};
/// # use tests::assert;
/// let v = Vec::from([1, 2, 3]);
/// assert!(heap_bytes() > 0 && v.len() == 3);
/// ```
fn heap_bytes() -> int {}

/// Runs every pending `fn drop()` and the cycle collector now, and returns
/// the number of bytes freed.
///
/// Values are freed as soon as their last owner goes; only reference cycles
/// between class instances wait for the cycle collector, which also runs on
/// its own as the heap grows. Call this to free such cycles, or run their
/// finalizers, at a known point, for example in tests. Values still named
/// by live locals stay alive.
///
/// # Examples
///
/// ```
/// use gc::{collect};
/// # use tests::assert;
/// let freed = collect();
/// assert!(freed >= 0);
/// ```
fn collect() -> int {}
