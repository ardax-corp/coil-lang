// Doc stubs for the builtin `ffi::types` module (hover docs; never compiled).
//
// Each FFI type tag is its own export. `Bytes` and `ConstBytes` name buffer
// parameters in an `extern` block; the other tags name the C types that the
// bare names in an `extern` block (`int`, `float`, `string`, `ptr`, ...) stand
// for.

/// FFI tag for a 64-bit signed integer (`int64_t`), passed from and returned as `int`.
///
/// Written `int` in an `extern` block.
///
/// # Examples
///
/// ```text
/// extern "sum" {
///     fn sum(int a, int b) -> int; // int64_t sum(int64_t, int64_t)
/// }
///
/// let n = sum(40, 2);
/// ```
class Int {}

/// FFI tag for a 64-bit float (`double`), passed from and returned as `float`.
///
/// Written `float` in an `extern` block.
class Float {}

/// FFI tag for a NUL-terminated C string (`const char *`), passed from and returned as `string`.
///
/// A Coil string is passed as a pointer to its UTF-8 bytes; C must not keep
/// it after the call. A returned `char *` is copied into a new Coil string
/// at once (a null pointer gives an empty string), and C keeps ownership of
/// its memory.
class String {}

/// FFI tag for no value (`void`), valid only as a return type.
///
/// In an `extern` block, leave out the `->` result.
class Void {}

/// FFI tag for a C `bool` (one byte, `0` or `1`), passed from and returned as `bool`.
class Bool {}

/// FFI tag for an 8-bit signed integer (`int8_t`), passed from and returned as `int`.
///
/// Wider values are truncated when passed.
class Int8 {}

/// FFI tag for a 16-bit signed integer (`int16_t`), passed from and returned as `int`.
///
/// Wider values are truncated when passed.
class Int16 {}

/// FFI tag for a 32-bit signed integer (`int32_t`), passed from and returned as `int`.
///
/// Wider values are truncated when passed.
class Int32 {}

/// FFI tag for an 8-bit unsigned integer (`uint8_t`), passed from and returned as `int`.
class UInt8 {}

/// FFI tag for a 16-bit unsigned integer (`uint16_t`), passed from and returned as `int`.
class UInt16 {}

/// FFI tag for a 32-bit unsigned integer (`uint32_t`), passed from and returned as `int`.
class UInt32 {}

/// FFI tag for a 64-bit unsigned integer (`uint64_t`), passed from and returned as `int`.
///
/// Values above the largest `int` come back negative (the same 64 bits).
class UInt64 {}

/// FFI tag for a raw pointer (`void *`), returned as an `int` address.
///
/// Written `ptr` in an `extern` block. A `Vec<int>` parameter is passed as
/// a pointer to a temporary `int64_t[]` copy whose changes are copied back
/// after the call. Keep a value C retains alive with `gc::root`.
///
/// # Examples
///
/// ```text
/// extern "sum" {
///     // int64_t sum_array(const int64_t *xs, int64_t n)
///     fn sum_array(Vec<int> xs, int n) -> int;
/// }
///
/// let n = sum_array([1, 2, 3, 4, 5], 5); // 15
/// ```
class Ptr {}

/// FFI tag for a C function pointer, letting C call back into a Coil function.
///
/// Written as a function type in an `extern` block (`fn(int x) -> int cb`).
/// Pass a named top-level Coil function; C receives a pointer it can call.
///
/// # Examples
///
/// ```text
/// extern "sum" {
///     // int64_t apply_cb(int64_t (*f)(int64_t), int64_t x) { return f(x); }
///     fn apply_cb(fn(int x) -> int f, int x) -> int;
/// }
///
/// fn doubler(int x) -> int {
///     return x * 2;
/// }
///
/// let n = apply_cb(doubler, 21); // 42
/// ```
class Callback {}

/// FFI tag for a C struct passed or returned by value.
///
/// Not written directly: name an `extern struct` type in an `extern` block
/// instead, and the compiler uses this tag with that struct's layout. A
/// returned struct becomes a record whose fields are read with `.name`.
///
/// # Examples
///
/// ```text
/// extern struct Point {
///     x: float,
///     y: float,
/// };
///
/// extern "geom" {
///     fn make_point(float x, float y) -> Point;
/// }
///
/// let p = make_point(3.0, 4.0);
/// let sum = p.x + p.y; // 7.0
/// ```
class Struct {}

/// FFI tag for a writable byte buffer (`uint8_t *`) made from a `Vec<byte>`.
///
/// Whatever C writes there ends up in the `Vec`: a packed `Vec<byte>` is lent
/// in place, and otherwise (a coil callback exists, the same `Vec` is passed
/// twice, or its elements are stored as words) C gets a copy that is copied
/// back after the call. No NUL terminator is added, so pass the length
/// separately. Argument only (return a `ptr` instead).
class Bytes {}

/// FFI tag for a read-only byte view (`const uint8_t *`) of a `string` or `Vec<byte>`.
///
/// A string is lent in place without a copy, and so is a packed `Vec<byte>`
/// under the same rules as `Bytes`; any other `Vec<byte>` is copied in once
/// and never copied back. No NUL terminator is added, so pass the length
/// separately. Argument only.
class ConstBytes {}
