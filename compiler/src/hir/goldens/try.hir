Function g(n%0: int) -> enum Result { Ok(int), Err(string) } [pair Result] result-mode
  block : never
    if : never
      bin Lt : bool
        local n%0 : int
        lit 0 : int {nonneg}
      block : never
        =>
          return : never
            make Result::Err#1 : enum Result { Ok(int), Err(string) } [pair Result]
              lit "neg" : string
    =>
      return : never
        make Result::Ok#0 : enum Result { Ok(int), Err(string) } [pair Result]
          local n%0 : int

Function f(n%0: int) -> enum Result { Ok(int), Err(string) } [pair Result] result-mode
  block : never
    let v%3: int : unit
      match : int
