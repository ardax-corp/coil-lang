// Hundreds of inlined calls pushing heap and scalar values, with a running
// total, in one body: registers are shared between values never live at
// once, and heap words never share one with scalars (#1375).
use tests::assert;

fn put(Vec<int> codes, Vec<string> names, int code) {
    codes.push(code);
    names.push("x");
}

