test("hundreds of inlined calls") {
    let codes: Vec<int> = [];
    let names: Vec<string> = [];
    let t = fill(codes, names);
    assert!(t == 44850);
    assert!(len(codes) == 300);
    assert!(len(names) == 300);
    assert!(codes[299] == 299);
    assert!(names[299] == "x");
}
