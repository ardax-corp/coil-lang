    huff_push(codes, lens, 80, 12);
    huff_push(codes, lens, 87, 13);
    huff_push(codes, lens, 94, 14);
    huff_push(codes, lens, 101, 15);
    huff_push(codes, lens, 108, 16);
    huff_push(codes, lens, 115, 17);
    huff_push(codes, lens, 122, 18);
    huff_push(codes, lens, 129, 19);
    huff_push(codes, lens, 136, 20);
    huff_push(codes, lens, 143, 21);
    huff_push(codes, lens, 150, 22);
    huff_push(codes, lens, 157, 23);
    huff_push(codes, lens, 164, 24);
    huff_push(codes, lens, 171, 25);
    huff_push(codes, lens, 178, 26);
    huff_push(codes, lens, 185, 27);
    huff_push(codes, lens, 192, 28);
    huff_push(codes, lens, 199, 29);
    huff_push(codes, lens, 206, 30);
    huff_push(codes, lens, 213, 1);
    huff_push(codes, lens, 220, 2);
