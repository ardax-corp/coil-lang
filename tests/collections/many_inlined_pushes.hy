// Many calls to a small helper that pushes onto two Vec parameters, all
// inlined into one body, still get a GC stack map (#1375).
use tests::assert;

fn huff_push(Vec<int> codes, Vec<int> lens, int code, int nbits) {
    codes.push(code);
    lens.push(nbits);
}

fn huff_fill(Vec<int> codes, Vec<int> lens) {
    huff_push(codes, lens, 3, 1);
    huff_push(codes, lens, 10, 2);
    huff_push(codes, lens, 17, 3);
    huff_push(codes, lens, 24, 4);
    huff_push(codes, lens, 31, 5);
    huff_push(codes, lens, 38, 6);
    huff_push(codes, lens, 45, 7);
