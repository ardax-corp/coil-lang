    huff_push(codes, lens, 906, 10);
}

test("many inlined pushes") {
    let codes: Vec<int> = [];
    let lens: Vec<int> = [];
    huff_fill(codes, lens);
    assert!(len(codes) == 130);
    assert!(codes[129] == 906);
    assert!(lens[129] == 10);
}
