// Two equal values compare equal however their parts are shared (#2681):
// a `Vec` or array holding one object twice equals one holding two equal
// copies. A shared generic body that pushes its `T` twice builds such a
// `Vec` (at `--clone-budget 0`, a `Vec<Option<int>>` of one box twice, the
// other side a lane array the comparison converts), and so does ground
// code that pushes one tuple, `Vec` or boxed value twice.
use tests::assert;
use string::format;

#[inline(never)]
fn two<T>(T x) -> Vec<T> {
    let out = Vec::new();
    out.push(x);
    out.push(x);
    return out;
}

#[inline(never)]
fn has<T: Eq>(Vec<T> v, T x) -> bool {
    for y in v {
        if y == x {
            return true;
        }
    }
    return false;
}

#[inline(never)]
fn pair_of<T>(T x) -> [T; 2] {
    return [x, x];
}

test("a shared body's Vec of one value twice equals two equal copies") {
    let v = two(Option::Some(3));
    assert!(v == Vec::from([Option::Some(3), Option::Some(3)]));
    assert!(!(v != Vec::from([Option::Some(3), Option::Some(3)])));
    assert!(v != Vec::from([Option::Some(3), Option::None]));
    assert!(two((1, 2)) == Vec::from([(1, 2), (1, 2)]));
    assert!(two(Option::Some("s")) == Vec::from([Option::Some("s"), Option::Some("s")]));
    assert!(two(1.5) == Vec::from([1.5, 1.5]));
    assert!(two((1, "a")) == Vec::from([(1, "a"), (1, "a")]));
    assert!(two(Result::Ok(2)) == Vec::from([Result::Ok(2), Result::Ok(2)]));
}

test("a fixed array of one value twice equals two equal copies") {
    assert!(pair_of(Option::Some(3)) == [Option::Some(3), Option::Some(3)]);
    assert!(pair_of((4, 5)) == [(4, 5), (4, 5)]);
    assert!(pair_of(Option::Some("t")) == [Option::Some("t"), Option::Some("t")]);
    assert!(pair_of(2.5) == [2.5, 2.5]);
    assert!(pair_of(Option::Some(3)).hash() == [Option::Some(3), Option::Some(3)].hash());
    assert!(pair_of((4, 5)).hash() == [(4, 5), (4, 5)].hash());
}

test("ground code holding one object twice") {
    let t = (1, "a");
    assert!(Vec::from([t, t]) == Vec::from([(1, "a"), (1, "a")]));
    let s = Vec::from(["x"]);
    assert!(Vec::from([s, s]) == Vec::from([Vec::from(["x"]), Vec::from(["x"])]));
    assert!(Vec::from([s, s]) != Vec::from([Vec::from(["x"]), Vec::from(["y"])]));
    let o = Option::Some(Vec::from([1]));
    assert!([o, o] == [Option::Some(Vec::from([1])), Option::Some(Vec::from([1]))]);
}

test("the same values show, search and match alike") {
    let v = two(Option::Some(3));
    let w = Vec::from([Option::Some(3), Option::Some(3)]);
    assert!(format("%v", v) == format("%v", w));
    assert!(has(Vec::from([v, w]), w));
    assert!(has(v, Option::Some(3)));
    assert!(!has(v, Option::None));
    let hits = 0;
    for o in v {
        match o {
            Option::Some(3) => hits = hits + 1,
            default => hits = hits + 100,
        }
    }
    assert!(hits == 2);
    let p = two((7, 8));
    let (a, b) = p[1];
    assert!(a == 7 && b == 8);
    assert!(has(p, (7, 8)));
}
