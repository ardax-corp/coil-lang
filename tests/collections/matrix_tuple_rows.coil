// A `Matrix` over tuples (a tuple of row tuples, an array of row tuples, a
// tuple of row arrays) is its data at run time wherever a value of it is
// held: a local, a parameter, a result, a capture, an item of another value.
use tests::assert;

fn first(Matrix<((int, int), (int, int))> m) -> (int, int) {
    return m[0];
}

fn ident(Matrix<((int, int), (int, int))> m) -> Matrix<((int, int), (int, int))> {
    return m;
}

fn id<T>(T x) -> T {
    return x;
}

test("a local holds a matrix over a tuple of row tuples") {
    let a = matrix(((250, 1), (2, 3)));
    let s = a;
    assert!(s[0][0] == 250 && s[0][1] == 1 && s[1][0] == 2 && s[1][1] == 3);
    let row = s[0];
    assert!(row[0] == 250 && row[1] == 1);
}

test("it passes through calls") {
    let a = matrix(((250, 1), (2, 3)));
    let r = first(a);
    assert!(r[0] == 250 && r[1] == 1);
    let b = ident(a);
    assert!(b[1][1] == 3);
    let c = id(a);
    assert!(c[1][0] == 2);
}

test("three rows of floats") {
    let a = matrix(((1.5, 2.5, 3.5), (4.5, 5.5, 6.5), (7.5, 8.5, 9.5)));
    let s = a;
    assert!(s[2][2] == 9.5 && s[0][1] == 2.5);
}

test("operators") {
    let a = matrix(((1, 2), (3, 4)));
    let b = matrix(((5, 6), (7, 8)));
    let c = a * b;
    assert!(c[0][0] == 19 && c[0][1] == 22 && c[1][0] == 43 && c[1][1] == 50);
    let d = a + b;
    assert!(d[0][0] == 6 && d[1][1] == 12);
    let n = -a;
    assert!(n[1][0] == -3);
}

test("an array of row tuples and a tuple of row arrays") {
    let a = matrix([(1, 2), (3, 4)]);
    let s = a;
    assert!(s[1][0] == 3);
    let b = matrix(([1, 2], [3, 4]));
    let t = b;
    assert!(t[1][1] == 4);
}

test("in an option, an array, a tuple and a closure") {
    let a = matrix(((1, 2), (3, 4)));
    let o = Some(a);
    let got = match o {
        Some(m) => m[1][1],
        None => 0,
    };
    assert!(got == 4);
    let v = [a, a];
    let e = v[1];
    assert!(e[0][1] == 2);
    let pair = (a, a);
    assert!(pair[1][0][1] == 2);
    let f = fn () use (a) => a[1][0];
    assert!(f() == 3);
}

test("typeof names the matrix") {
    let a = matrix(((1, 2), (3, 4)));
    assert!(typeof a == "prelude::math::Matrix<((int, int), (int, int))>");
    let b = matrix([[1, 2], [3, 4]]);
    assert!(typeof b == "prelude::math::Matrix<[[int; 2]; 2]>");
}
