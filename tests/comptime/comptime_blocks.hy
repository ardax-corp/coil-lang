// @flags --comptime-read tests/comptime/data
// A top-level `comptime { … }` block runs while compiling and the `Code` it
// returns replaces it: here functions and classes, generated by code from
// other modules, from a computed value, a file and a quote.
use comptime_gen::{adder, records};
use comptime_block_lib::add_ten;
use io::file::read_text;
use macro::ident;
use text::lines;
use tests::assert;

comptime {
    let n = 2 * 20;
    return adder("add_forty", n);
}

comptime {
    let text = read_text("tests/comptime/data/names.txt") ?? "";
    let names: Vec<string> = lines(text) ?? [];
    return records(names);
}

comptime {
    let name = ident("triple");
    return quote items {
        fn ${name}(int x) -> int {
            return x * 3;
        }
    };
}

test("a block's functions are this module's") {
    assert!(add_forty(2) == 42);
    assert!(triple(3) == 9);
}

test("a block in an imported module") {
    assert!(add_ten(1) == 11);
}

test("classes from a file") {
    let a = new Alpha(1);
    let b = new Beta(2);
    assert!(a.id + b.id == 3);
    assert!(a.name() + b.name() == "AlphaBeta");
}
