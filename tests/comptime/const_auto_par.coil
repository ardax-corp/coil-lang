// A `const` runs the bodies the program runs, and auto-par splits their
// loops. Compile-time code has no threads: the spawn fails, and the fork runs
// the range on this thread, as it does at any failed spawn (#2273).
use tests::assert;

fn sum_of_squares(int n) -> int {
    let total = 0;
    for i in 0..n {
        total += i * i;
    }
    return total;
}

const TOTAL = sum_of_squares(1000);

test("a const folds a loop auto-par splits") {
    assert!(TOTAL == 332833500);
}
