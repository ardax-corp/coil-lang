// A counted loop that reads a `byte` local, or runs under an `invariant`
// that only reads what the loop leaves alone, gives the sequential result:
// a parallel loop's words are `int` locals, and a `while` under a contract
// check runs sequentially (#2450).
use tests::assert;

fn weight(int i) -> int {
    return i % 7;
}

// A `byte` parameter read in the loop.
fn with_byte(byte flag, int n) -> int {
    let total = 0;
    let i = 0;
    while i < n {
        total = total + weight(i);
        if flag == flag {
            total = total + 1;
        }
        i = i + 1;
    }
    return total;
}

// A `byte` range.
fn byte_range(byte i, byte n) -> int {
    let total = 0;
    while i < n {
        total = total + 3;
        i = i + (1 as byte);
    }
    return total;
}

fn checked_while(int n, int k) -> int {
    let total = 0;
    let i = 0;
    while i < n
        invariant k > 0
    {
        total = total + weight(i) * k;
        i = i + 2;
    }
    return total * 10000000 + i;
}

test("a byte local in a counted loop") {
    // 0..70000 is 10000 cycles of 0..6, which add up to 21.
    assert!(with_byte(3 as byte, 70000) == 10000 * 21 + 70000);
    assert!(with_byte(3 as byte, 0) == 0);
    assert!(byte_range(3 as byte, 200 as byte) == 197 * 3);
}

test("a while loop under an invariant of what it leaves alone") {
    // The even numbers below 70000: 5000 cycles of 0, 2, 4, 6, 1, 3, 5.
    assert!(checked_while(70000, 2) == 5000 * 21 * 2 * 10000000 + 70000);
    assert!(checked_while(70001, 1) == (5000 * 21 + 0) * 10000000 + 70002);
    assert!(checked_while(0, 1) == 0);
}
