// An explicit `use m::diff` shadows the prelude `diff`; names not imported
// still resolve to the prelude (#1488).
use tests::assert;
use prelude_clash::{diff, black_box as pbb};

test("imported fn shadows prelude diff") {
    assert!(diff(7, 2) == 5);
}

test("unimported prelude name stays the builtin") {
    assert!(black_box(97) == 97);
    assert!(pbb(97) == 100);
}

test("imported fn shadows prelude diff inside a lambda") {
    let f = fn (int a) => diff(a, 1);
    assert!(f(5) == 4);
}
