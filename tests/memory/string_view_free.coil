// Strings that are views of a shared buffer (the results of `s = s + x`,
// which append in place) freed as their owners go: a view another view
// still holds the buffer for gives its slot back at once, the last view
// of a buffer frees the buffer too, and the bytes every later string
// reads stay its own.
use tests::assert;
use string::format;
use gc::{collect, upgrade, weak};

// `n` pieces appended one by one: each step frees the step before it,
// a view of the same buffer.
fn grown(int n) -> string {
    let s = "start-of-a-string-longer-than-inline:";
    let i = 0;
    while i < n {
        s = s + format("%i,", i % 10);
        i = i + 1;
    }
    return s;
}

// The same text built by copying, never through a shared buffer.
fn expected(int n) -> string {
    let out = "start-of-a-string-longer-than-inline:";
    let i = 0;
    while i < n {
        out = format("%s%i,", out, i % 10);
        i = i + 1;
    }
    return out;
}

// Two strings grown from one prefix: the second cannot append in place,
// so it copies into a buffer of its own while the first keeps the
// original. Both are dropped on return, each the last view of its buffer.
fn forked(int i) -> int {
    let base = grown(i % 30 + 1);
    let a = base + "a";
    let b = base + "b";
    if a.len() != b.len() {
        return -1;
    }
    return a.len() + b.len();
}

// A view a weak handle names: freed the general way.
fn weak_view(int i) -> bool {
    let s = grown(i % 5 + 1) + "!";
    let w = weak(s);
    return match upgrade(w) {
        Option::Some(v) => v == s,
        Option::None => false,
    };
}

test("appending in a loop frees each step's view") {
    let n = 1;
    while n < 400 {
        assert!(grown(n) == expected(n));
        n = n + 37;
    }
}

test("the last view of a buffer frees it too") {
    let total = 0;
    let i = 0;
    while i < 2000 {
        total = total + forked(i);
        i = i + 1;
    }
    assert!(total > 2000 * 2 * 38);
    collect();
    assert!(grown(250) == expected(250));
}

test("a view a weak handle names is not freed early") {
    let i = 0;
    let alive = 0;
    while i < 300 {
        if weak_view(i) {
            alive = alive + 1;
        }
        i = i + 1;
    }
    assert!(alive == 300);
    collect();
}

test("views held in an array outlive the steps that made them") {
    let kept: Vec<string> = Vec::new();
    let s = "prefix-long-enough-for-a-buffer-view:";
    let i = 0;
    while i < 200 {
        s = s + "x";
        if i % 20 == 0 {
            kept.push(s);
        }
        i = i + 1;
    }
    assert!(kept.len() == 10);
    let j = 0;
    while j < kept.len() {
        assert!(kept[j].len() == 37 + j * 20 + 1);
        j = j + 1;
    }
}
