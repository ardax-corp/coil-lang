// A loop that writes through a field of a class local whose fields live in
// frame slots (only ever a field base) gets its loop view like any other
// path (#2779): the view's rewrite leaves no stale read of the local whole.
use tests::assert;

class H {
    pub f: Vec<int>,
}

class Two {
    pub a: Vec<int>,
    pub n: int,
}

class Outer {
    pub h: H,
}

test("a range for over a field's elements") {
    let h = new H([1, 2, 3]);
    for i in 0..3 {
        h.f[i] += i;
    }
    assert!(h.f.len() == 3 && h.f[0] == 1 && h.f[1] == 3 && h.f[2] == 5);
}

test("a while loop, and another field read after") {
    let t = new Two([0, 0, 0, 0], 4);
    let i = 0;
    while i < t.n {
        t.a[i] = i * i;
        i += 1;
    }
    assert!(t.a[3] == 9 && t.a[1] == 1 && t.n == 4);
}

test("a nested path") {
    let o = new Outer(new H([5, 5]));
    for i in 0..2 {
        o.h.f[i] -= i + 1;
    }
    assert!(o.h.f[0] == 4 && o.h.f[1] == 3);
}

test("the field's Vec stays the local's own") {
    let xs: Vec<int> = [1, 1];
    let h = new H(xs);
    for i in 0..2 {
        h.f[i] *= 10;
    }
    assert!(xs[0] == 1 && h.f[0] == 10 && h.f[1] == 10);
}
