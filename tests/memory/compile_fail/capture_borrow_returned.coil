// @expected E0149 — a `use (mut a)` closure that is returned would hold its
// borrow of `a` past `a`'s scope (#2787).
class C {
    pub x: int,
}

fn counter() -> fn() -> int {
    let a = new C(0);
    return fn () use (mut a) {
        a.x += 1;
        return a.x;
    };
}

fn main() {
    let f = counter();
    let _ = f();
}
