// @expected E0149 — `a` is passed to a function that keeps it while a
// `use (mut a)` closure borrows it (#2787).
class C {
    pub x: int,
}

class H {
    pub c: C,
}

fn peek(C c) -> int {
    let h = new H(c);
    return h.c.x;
}

fn main() {
    let a = new C(1);
    let f = fn () use (mut a) {
        a.x += 10;
        return a.x;
    };
    let _ = f();
    let _ = peek(a);
    a.x += 100;
    let _ = f();
}
