// @expected E0149 — the borrowed object gets a second name while the view lives.
class Counter {
    pub n: int,
}

view class Bump {
    mut c: Counter,
}

impl Bump {
    pub fn go() {
        self.c.n += 1;
    }
}

fn main() {
    let k = new Counter(1);
    let b = new Bump(mut k);
    let k2 = k;
    b.go();
    let _ = k2.n;
}
