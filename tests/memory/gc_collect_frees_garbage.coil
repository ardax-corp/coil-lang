// `gc::collect()` returns the bytes it freed: never negative, more than zero
// after garbage was made, and less on a second collect with nothing new. The
// garbage is cycles of `shared class` nodes: no count reaches zero on them,
// so only a collection frees them.
use tests::assert;
use gc::collect;

shared class Ring {
    pub payload: Vec<int>,
    pub next: Option<Ring>,
}

// Rings of two nodes, each pointing at the other, dropped on return.
fn garbage() {
    let i = 0;
    while i < 200 {
        let a = new Ring(Vec::from([i, i + 1, i + 2]), Option::None);
        let b = new Ring(Vec::from([i]), Option::Some(a));
        a.next = Option::Some(b);
        i += 1;
    }
}

test("collect is never negative") {
    assert!(collect() >= 0);
    assert!(collect() >= 0);
}

test("collect frees unreachable garbage") {
    collect();
    garbage();
    let freed = collect();
    assert!(freed > 0, "freed something");
    let again = collect();
    assert!(again < freed);
}
