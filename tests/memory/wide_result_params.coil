// A `Result` of a tuple whose `Err` is a heap word crosses a direct call
// as its words: the `Ok` tuple's words, the `Err` payload in a word it
// shares with one of them, and an `Ok` flag. As a parameter and a result,
// counted where a word may be an object.
use tests::assert;
use gc::collect;
use string::format;

static let drops: int = 0;

class Handle {
    pub fd: int,
}

impl Handle {
    fn drop() {
        drops = drops + 1;
    }
}

#[inline(never)]
fn get(int a) -> Result<(int, int, int), string> {
    if a % 3 == 0 {
        return Err(format("bad %i", a));
    }
    return Ok((a, a + 1, a + 2));
}

#[inline(never)]
fn total(Result<(int, int, int), string> r) -> int {
    return match r {
        Ok(t) => t[0] + t[1] * 10 + t[2] * 100,
        Err(e) => -e.len(),
    };
}

#[inline(never)]
fn relay(Result<(int, int, int), string> r, int k) -> int {
    if k == 0 {
        return total(r);
    }
    return relay(r, k - 1) + 1;
}

#[inline(never)]
fn pass(Result<(int, int, int), string> r) -> Result<(int, int, int), string> {
    return r;
}

#[inline(never)]
fn open(int a) -> Result<(Handle, int), Handle> {
    if a % 2 == 0 {
        return Err(new Handle(a * 100));
    }
    return Ok((new Handle(a), a));
}

#[inline(never)]
fn fds(Result<(Handle, int), Handle> r) -> int {
    return match r {
        Ok(t) => t[0].fd * 10 + t[1],
        Err(h) => h.fd,
    };
}

#[inline(never)]
fn kept(Result<(int, int, int), string> r) -> Vec<Result<(int, int, int), string>> {
    let v: Vec<Result<(int, int, int), string>> = [];
    v.push(r);
    return v;
}

test("an Ok, an Err and a call's Result go to a call as words") {
    let s = 0;
    let i = 0;
    while i < 9 {
        s += total(get(i));
        s += total(Ok((i, 1, 2)));
        s += total(Err("no"));
        i += 1;
    }
    let expect = 0;
    let j = 0;
    while j < 9 {
        expect += if j % 3 == 0 {
            -format("bad %i", j).len()
        } else {
            j + (j + 1) * 10 + (j + 2) * 100
        };
        expect += j + 10 + 200 - 2;
        j += 1;
    }
    assert!(s == expect);
}

test("a Result parameter passed on and returned") {
    assert!(relay(Ok((1, 2, 3)), 3) == 321 + 3);
    assert!(relay(Err("abc"), 2) == -3 + 2);
    assert!(total(pass(Ok((4, 5, 6)))) == 654);
    assert!(total(pass(Err("x"))) == -1);
    assert!(total(pass(get(4))) == 4 + 50 + 600);
    assert!(total(pass(get(3))) == -5);
}

test("a Result of heap words is counted") {
    drops = 0;
    let s = 0;
    let i = 0;
    while i < 6 {
        s += fds(open(i));
        i += 1;
    }
    collect();
    assert!(drops == 6);
    assert!(s == 0 + 11 + 200 + 33 + 400 + 55);
}

test("a callee that keeps the Result gets the object") {
    let v = kept(Ok((7, 8, 9)));
    assert!(total(v[0]) == 987);
    let w = kept(Err("four"));
    assert!(total(w[0]) == -4);
}
