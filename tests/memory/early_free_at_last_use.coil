// @skip rc-check the heap check at every safepoint walks the 100k-node list each time
// A local the early-free pass frees goes after the statement that last
// names it, not at the end of its block: a big structure does not live on
// through the rest of the block. A type with a `drop` still waits for the
// end of its scope.
use tests::assert;
use gc::heap_bytes;

class Node {
    pub v: int,
    pub next: Option<Node>,
}

fn build(int n) -> Option<Node> {
    let head: Option<Node> = None;
    let i = 0;
    while i < n {
        head = Some(new Node(i, head));
        i += 1;
    }
    return head;
}

fn length(Option<Node> l) -> int {
    let n = 0;
    let at = l;
    while true {
        match at {
            Some(x) => {
                n += 1;
                at = x.next;
            },
            None => {
                return n;
            },
        }
    }
    return n;
}

static let drops: int = 0;

class Tracked {
    pub n: int,
}

impl Tracked {
    fn drop() {
        drops += 1;
    }
}

test("a dead local's list is freed before the block ends") {
    let before = heap_bytes();
    let big = build(100000);
    assert!(length(big) == 100000);
    let during = heap_bytes() - before;
    assert!(during < 1000000);
}

test("a local with a drop is not freed at its last use") {
    drops = 0;
    {
        let t = new Tracked(3);
        assert!(t.n == 3);
        assert!(drops == 0);
    }
}
