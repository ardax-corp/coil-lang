// `gc::get` of a `Root<unit>` returns an `Option<unit>` (#1449). A
// `weak(())` is refused (E0119): `()` has no object of its own.
use tests::assert;
use gc::{root, get, unroot};

test("get of a unit root is Some") {
    let r = root(());
    assert!(match get(r) {
        Option::Some(u) => u == (),
        Option::None => false,
    });
    unroot(r);
}
