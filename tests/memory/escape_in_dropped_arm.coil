// A class local whose only whole use sits in an arm a constant condition
// drops: with the arm gone it is only ever a field base, and its field
// writes and reads still agree.
use tests::assert;

class Tally {
    pub hits: int,
}

#[inline(never)]
fn bump(Tally t) -> int {
    t.hits = t.hits + 1;
    return 0;
}

test("an escape inside an arm a false constant drops") {
    let t = new Tally(5);
    let on = false;
    if on {
        bump(t);
    }
    t.hits = t.hits + 1;
    assert!(t.hits == 6);
}

test("an escape inside an arm a true constant keeps") {
    let t = new Tally(5);
    let on = true;
    if on {
        bump(t);
    }
    t.hits = t.hits + 1;
    assert!(t.hits == 7);
}

test("an escape inside an arm a folded comparison drops") {
    let t = new Tally(1);
    let r = 0;
    if r > 0 {
        bump(t);
    } else {
        t.hits = t.hits + 2;
    }
    assert!(t.hits == 3);
}
