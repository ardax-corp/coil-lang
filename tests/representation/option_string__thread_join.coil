// @output some one\nnone\n
//
// Representation matrix cell option_string x thread_join: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;
use thread::{join, spawn};

fn say(Option<string> v) -> string {
    return match v {
        Some(s) => "some " + s,
        None => "none",
    };
}

fn threaded(Option<string> x) -> Option<string> {
    let th = match spawn(fn () use (x) => x) {
        Ok(t) => t,
        Err(_) => panic "spawn",
    };
    // `Thread` is untyped: pin the joined value's type, or a
    // result-mode `return` wraps it as the `Ok` payload.
    let got: Option<string> = match join(th) {
        Ok(v) => v,
        Err(_) => panic "join",
    };
    return got;
}

fn main() {
    let a: Option<string> = Some("one");
    let b: Option<string> = None;
    println(say(threaded(a)))?;
    println(say(threaded(b)))?;
}
