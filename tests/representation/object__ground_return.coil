// @output obj 1\nobj 2\n
//
// Representation matrix cell object x ground_return: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
class Obj {
    pub n: int,
}

fn say(Obj v) -> string {
    return format("obj %i", v.n);
}

fn made_a() -> Obj {
    return new Obj(1);
}

fn made_b() -> Obj {
    return new Obj(2);
}

fn main() {
    let a: Obj = new Obj(1);
    let b: Obj = new Obj(2);
    println(say(made_a()))?;
    println(say(made_b()))?;
}
