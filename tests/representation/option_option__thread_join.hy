// @output some some one\nsome none\n
//
// Representation matrix cell option_option x thread_join: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;
use thread::{join, spawn};

fn say(Option<Option<string>> v) -> string {
    return match v {
        Some(Some(s)) => "some some " + s,
        Some(None) => "some none",
        None => "none",
    };
}

fn threaded(Option<Option<string>> x) -> Option<Option<string>> {
    let th = match spawn(fn () use (x) => x) {
        Ok(t) => t,
        Err(_) => panic "spawn",
    };
    return match join(th) {
        Ok(v) => v,
        Err(_) => panic "join",
    };
}

fn main() {
    let a: Option<Option<string>> = Some(Some("one"));
    let b: Option<Option<string>> = Some(None);
    println(say(threaded(a)))?;
    println(say(threaded(b)))?;
}
