// @output held 4\ngone\n
//
// Representation matrix cell drop_enum x ground_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
enum Res {
    Held(int),
    Gone,
}

impl Res {
    fn drop() {}
}

fn say(Res v) -> string {
    return match v {
        Res::Held(n) => format("held %i", n),
        Res::Gone => "gone",
    };
}

fn pass(Res v) -> Res {
    let w = v;
    return w;
}

fn main() {
    let a: Res = Res::Held(4);
    let b: Res = Res::Gone;
    println(say(pass(a)))?;
    println(say(pass(b)))?;
}
