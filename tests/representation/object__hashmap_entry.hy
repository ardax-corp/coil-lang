// @output obj 1\nobj 2\n
//
// Representation matrix cell object x hashmap_entry: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
class Obj {
    pub n: int,
}

fn say(Obj v) -> string {
    return format("obj %i", v.n);
}

fn entried(Obj x) -> Obj {
    let m: HashMap<string, Obj> = HashMap::new();
    m.insert("k", x);
    for e in m {
        return e.value;
    }
    return x;
}

fn main() {
    let a: Obj = new Obj(1);
    let b: Obj = new Obj(2);
    println(say(entried(a)))?;
    println(say(entried(b)))?;
}
