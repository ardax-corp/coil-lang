// @output some 7\nnone\n
//
// Representation matrix cell option_int x closure_capture: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<int> v) -> string {
    return match v {
        Some(n) => format("some %i", n),
        None => "none",
    };
}

fn captured(Option<int> x) -> Option<int> {
    let f = fn () use (x) => x;
    return f();
}

fn main() {
    let a: Option<int> = Some(7);
    let b: Option<int> = None;
    println(say(captured(a)))?;
    println(say(captured(b)))?;
}
