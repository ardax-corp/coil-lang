// @output some some one\nsome none\n
//
// Representation matrix cell option_option x hashmap_values: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

fn say(Option<Option<string>> v) -> string {
    return match v {
        Some(Some(s)) => "some some " + s,
        Some(None) => "some none",
        None => "none",
    };
}

fn valued(Option<Option<string>> x) -> Option<Option<string>> {
    let m: HashMap<string, Option<Option<string>>> = HashMap::new();
    m.insert("k", x);
    return m.values()[0];
}

fn main() {
    let a: Option<Option<string>> = Some(Some("one"));
    let b: Option<Option<string>> = Some(None);
    println(say(valued(a)))?;
    println(say(valued(b)))?;
}
