// @output some one\nnone\n
//
// Representation matrix cell option_string x ground_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<string> v) -> string {
    return match v {
        Some(s) => "some " + s,
        None => "none",
    };
}

fn pass(Option<string> v) -> Option<string> {
    let w = v;
    return w;
}

fn main() {
    let a: Option<string> = Some("one");
    let b: Option<string> = None;
    println(say(pass(a)))?;
    println(say(pass(b)))?;
}
