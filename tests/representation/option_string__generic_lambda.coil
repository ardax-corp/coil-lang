// @output some one\nnone\n
//
// Representation matrix cell option_string x generic_lambda: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<string> v) -> string {
    return match v {
        Some(s) => "some " + s,
        None => "none",
    };
}

fn apply<W>(W w, W -> string f) -> string {
    return f(w);
}

fn main() {
    let a: Option<string> = Some("one");
    let b: Option<string> = None;
    println(apply(a, say))?;
    println(apply(b, say))?;
}
