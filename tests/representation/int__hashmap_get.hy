// @output int 7\nint -3\n
//
// Representation matrix cell int x hashmap_get: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

fn say(int v) -> string {
    return format("int %i", v);
}

fn mapped(int x) -> int {
    let m: HashMap<string, int> = HashMap::new();
    m.insert("k", x);
    return m.get_or("k", x);
}

fn main() {
    let a: int = 7;
    let b: int = -3;
    println(say(mapped(a)))?;
    println(say(mapped(b)))?;
}
