// @output tuple 1 2.5\ntuple 3 0.5\n
//
// Representation matrix cell tuple_pair x bounded_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say((int, float) v) -> string {
    let (x, y) = v;
    return format("tuple %i %v", x, y);
}

class KBox<K, V> {
    pub ks: Vec<K>,
    pub vs: Vec<V>,
}

impl KBox<K: Eq, V> {
    pub fn put(K k, V x) {
        self.ks.push(k);
        self.vs.push(x);
    }

    pub fn get(K k) -> V {
        let i = 0;
        while i < self.ks.len() - 1 && self.ks[i] != k {
            i = i + 1;
        }
        return self.vs[i];
    }
}

fn kboxed((int, float) x) -> KBox<string, (int, float)> {
    let ks: Vec<string> = Vec::new();
    let vs: Vec<(int, float)> = Vec::new();
    let c = new KBox(ks, vs);
    c.put("k", x);
    return c;
}

fn main() {
    let a: (int, float) = (1, 2.5);
    let b: (int, float) = (3, 0.5);
    println(say(kboxed(a).get("k")))?;
    println(say(kboxed(b).get("k")))?;
}
