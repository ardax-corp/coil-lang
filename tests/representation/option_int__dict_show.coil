// @output true\ntrue\n
//
// Representation matrix cell option_int x dict_show: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<int> v) -> string {
    return match v {
        Some(n) => format("some %i", n),
        None => "none",
    };
}

fn shown<W: Show>(W w) -> string {
    return w.show();
}

fn main() {
    let a: Option<int> = Some(7);
    let b: Option<int> = None;
    println(format("%v", shown(a) == a.show()))?;
    println(format("%v", shown(b) == b.show()))?;
}
