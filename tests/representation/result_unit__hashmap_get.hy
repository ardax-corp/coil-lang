// @output ok\nerr bad\n
//
// Representation matrix cell result_unit x hashmap_get: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

fn say(Result<(), string> v) -> string {
    return match v {
        Ok(_) => "ok",
        Err(e) => "err " + e,
    };
}

fn mapped(Result<(), string> x) -> Result<(), string> {
    let m: HashMap<string, Result<(), string>> = HashMap::new();
    m.insert("k", x);
    return m.get("k", x);
}

fn main() {
    let a: Result<(), string> = Ok(());
    let b: Result<(), string> = Err("bad");
    println(say(mapped(a)))?;
    println(say(mapped(b)))?;
}
