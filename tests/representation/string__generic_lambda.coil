// @output str one\nstr two\n
//
// Representation matrix cell string x generic_lambda: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(string v) -> string {
    return "str " + v;
}

fn apply<W>(W w, W -> string f) -> string {
    return f(w);
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(apply(a, say))?;
    println(apply(b, say))?;
}
