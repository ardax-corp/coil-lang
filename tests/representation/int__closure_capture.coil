// @output int 7\nint -3\n
//
// Representation matrix cell int x closure_capture: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(int v) -> string {
    return format("int %i", v);
}

fn captured(int x) -> int {
    let f = fn () use (x) => x;
    return f();
}

fn main() {
    let a: int = 7;
    let b: int = -3;
    println(say(captured(a)))?;
    println(say(captured(b)))?;
}
