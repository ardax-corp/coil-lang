// @output some 7\nnone\n
//
// Representation matrix cell option_int x vec_field_local: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<int> v) -> string {
    return match v {
        Some(n) => format("some %i", n),
        None => "none",
    };
}

class Box<V> {
    pub v: V,
    pub vs: Vec<V>,
}

impl Box<V> {
    pub fn put(V x) {
        self.v = x;
        self.vs.push(x);
    }

    pub fn get() -> V {
        return self.v;
    }

    pub fn at(int i) -> V {
        return self.vs[i];
    }
}

fn boxed(Option<int> x) -> Box<Option<int>> {
    let vs: Vec<Option<int>> = Vec::new();
    let c = new Box(x, vs);
    c.put(x);
    return c;
}

fn first(Vec<Option<int>> w) -> Option<int> {
    return w[0];
}

fn main() {
    let a: Option<int> = Some(7);
    let b: Option<int> = None;
    println(say(first(boxed(a).vs)))?;
    println(say(first(boxed(b).vs)))?;
}
