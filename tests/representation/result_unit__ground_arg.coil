// @output ok\nerr bad\n
//
// Representation matrix cell result_unit x ground_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<(), string> v) -> string {
    return match v {
        Ok(_) => "ok",
        Err(e) => "err " + e,
    };
}

fn pass(Result<(), string> v) -> Result<(), string> {
    let w = v;
    return w;
}

fn main() {
    let a: Result<(), string> = Ok(());
    let b: Result<(), string> = Err("bad");
    println(say(pass(a)))?;
    println(say(pass(b)))?;
}
