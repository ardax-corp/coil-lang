// @output ok\nerr bad\n
//
// Representation matrix cell result_unit x generic_return: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<(), string> v) -> string {
    return match v {
        Ok(_) => "ok",
        Err(e) => "err " + e,
    };
}

class Box<V> {
    pub v: V,
    pub vs: Vec<V>,
}

impl Box<V> {
    pub fn put(V x) {
        self.v = x;
        self.vs.push(x);
    }

    pub fn get() -> V {
        return self.v;
    }

    pub fn at(int i) -> V {
        return self.vs[i];
    }
}

fn boxed(Result<(), string> x) -> Box<Result<(), string>> {
    let vs: Vec<Result<(), string>> = Vec::new();
    let c = new Box(x, vs);
    c.put(x);
    return c;
}

fn main() {
    let a: Result<(), string> = Ok(());
    let b: Result<(), string> = Err("bad");
    println(say(boxed(a).get()))?;
    println(say(boxed(b).get()))?;
}
