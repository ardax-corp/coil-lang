// @output int 7\nint -3\n
//
// Representation matrix cell int x hashmap_entry: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

fn say(int v) -> string {
    return format("int %i", v);
}

fn entried(int x) -> int {
    let m: HashMap<string, int> = HashMap::new();
    m.insert("k", x);
    for e in m {
        return e.value;
    }
    return x;
}

fn main() {
    let a: int = 7;
    let b: int = -3;
    println(say(entried(a)))?;
    println(say(entried(b)))?;
}
