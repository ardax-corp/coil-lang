// @output some some one\nsome none\n
//
// Representation matrix cell option_option x ground_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<Option<string>> v) -> string {
    return match v {
        Some(Some(s)) => "some some " + s,
        Some(None) => "some none",
        None => "none",
    };
}

fn pass(Option<Option<string>> v) -> Option<Option<string>> {
    let w = v;
    return w;
}

fn main() {
    let a: Option<Option<string>> = Some(Some("one"));
    let b: Option<Option<string>> = Some(None);
    println(say(pass(a)))?;
    println(say(pass(b)))?;
}
