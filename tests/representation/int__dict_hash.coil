// @output true\ntrue\n
//
// Representation matrix cell int x dict_hash: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(int v) -> string {
    return format("int %i", v);
}

fn hashed<W: Hash>(W w) -> int {
    return w.hash();
}

fn main() {
    let a: int = 7;
    let b: int = -3;
    println(format("%v", hashed(a) == a.hash()))?;
    println(format("%v", hashed(b) == b.hash()))?;
}
