// @output int 7\nint -3\n
//
// Representation matrix cell int x generic_lambda: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(int v) -> string {
    return format("int %i", v);
}

fn apply<W>(W w, W -> string f) -> string {
    return f(w);
}

fn main() {
    let a: int = 7;
    let b: int = -3;
    println(apply(a, say))?;
    println(apply(b, say))?;
}
