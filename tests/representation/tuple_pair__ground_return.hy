// @output tuple 1 2.5\ntuple 3 0.5\n
//
// Representation matrix cell tuple_pair x ground_return: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say((int, float) v) -> string {
    let (x, y) = v;
    return format("tuple %i %v", x, y);
}

fn made_a() -> (int, float) {
    return (1, 2.5);
}

fn made_b() -> (int, float) {
    return (3, 0.5);
}

fn main() {
    let a: (int, float) = (1, 2.5);
    let b: (int, float) = (3, 0.5);
    println(say(made_a()))?;
    println(say(made_b()))?;
}
