// @output str one\nstr two\n
//
// Representation matrix cell string x hashmap_get: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

fn say(string v) -> string {
    return "str " + v;
}

fn mapped(string x) -> string {
    let m: HashMap<string, string> = HashMap::new();
    m.insert("k", x);
    return m.get_or("k", x);
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(say(mapped(a)))?;
    println(say(mapped(b)))?;
}
