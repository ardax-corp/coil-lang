// @output p 1.5 2.0\np 0.5 4.0\n
//
// Representation matrix cell pair_class x bounded_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

readonly class P {
    pub x: float,
    pub y: float,
}

fn say(P v) -> string {
    return format("p %v %v", v.x, v.y);
}

class KBox<K, V> {
    pub ks: Vec<K>,
    pub vs: Vec<V>,
}

impl KBox<K: Eq, V> {
    pub fn put(K k, V x) {
        self.ks.push(k);
        self.vs.push(x);
    }

    pub fn get(K k) -> V {
        let i = 0;
        while i < self.ks.len() - 1 && self.ks[i] != k {
            i = i + 1;
        }
        return self.vs[i];
    }
}

fn kboxed(P x) -> KBox<string, P> {
    let ks: Vec<string> = Vec::new();
    let vs: Vec<P> = Vec::new();
    let c = new KBox(ks, vs);
    c.put("k", x);
    return c;
}

fn main() {
    let a: P = new P(1.5, 2.0);
    let b: P = new P(0.5, 4.0);
    println(say(kboxed(a).get("k")))?;
    println(say(kboxed(b).get("k")))?;
}
