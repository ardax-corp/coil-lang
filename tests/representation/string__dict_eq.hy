// @output true false\ntrue false\n
//
// Representation matrix cell string x dict_eq: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(string v) -> string {
    return "str " + v;
}

fn same<W: Eq>(W a, W b) -> bool {
    return a == b;
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(format("%v %v", same(a, a), same(a, b)))?;
    println(format("%v %v", same(b, b), same(b, a)))?;
}
