// @output ok\nerr bad\n
//
// Representation matrix cell result_unit x closure_capture: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<(), string> v) -> string {
    return match v {
        Ok(_) => "ok",
        Err(e) => "err " + e,
    };
}

fn captured(Result<(), string> x) -> Result<(), string> {
    let f = fn () use (x) => x;
    return f();
}

fn main() {
    let a: Result<(), string> = Ok(());
    let b: Result<(), string> = Err("bad");
    println(say(captured(a)))?;
    println(say(captured(b)))?;
}
