// @output ok\nerr bad\n
//
// Representation matrix cell result_unit x tuple_item: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<(), string> v) -> string {
    return match v {
        Ok(_) => "ok",
        Err(e) => "err " + e,
    };
}

fn tupled<W>(W w) -> (W, int) {
    return (w, 1);
}

fn untupled(Result<(), string> x) -> Result<(), string> {
    let (y, _) = tupled(x);
    return y;
}

fn main() {
    let a: Result<(), string> = Ok(());
    let b: Result<(), string> = Err("bad");
    println(say(untupled(a)))?;
    println(say(untupled(b)))?;
}
