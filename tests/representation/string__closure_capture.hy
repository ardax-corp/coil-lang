// @output str one\nstr two\n
//
// Representation matrix cell string x closure_capture: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(string v) -> string {
    return "str " + v;
}

fn captured(string x) -> string {
    let f = fn () use (x) => x;
    return f();
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(say(captured(a)))?;
    println(say(captured(b)))?;
}
