// @expected E0801 — red in the representation matrix baseline (callee-generic, #1888)
//
// Representation matrix cell result_string x bounded_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<string, string> v) -> string {
    return match v {
        Ok(s) => "ok " + s,
        Err(e) => "err " + e,
    };
}

class KBox<K, V> {
    pub ks: Vec<K>,
    pub vs: Vec<V>,
}

impl KBox<K: Eq, V> {
    pub fn put(K k, V x) {
        self.ks.push(k);
        self.vs.push(x);
    }

    pub fn get(K k) -> V {
        let i = 0;
        while i < self.ks.len() - 1 && self.ks[i] != k {
            i = i + 1;
        }
        return self.vs[i];
    }
}

fn kboxed(Result<string, string> x) -> KBox<string, Result<string, string>> {
    let ks: Vec<string> = Vec::new();
    let vs: Vec<Result<string, string>> = Vec::new();
    let c = new KBox(ks, vs);
    c.put("k", x);
    return c;
}

fn main() {
    let a: Result<string, string> = Ok("one");
    let b: Result<string, string> = Err("bad");
    println(say(kboxed(a).get("k")))?;
    println(say(kboxed(b).get("k")))?;
}
