// @expected E0801 — red in the representation matrix baseline (callee-generic, #1888)
//
// Representation matrix cell result_string x hashmap_entry: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

fn say(Result<string, string> v) -> string {
    return match v {
        Ok(s) => "ok " + s,
        Err(e) => "err " + e,
    };
}

fn entried(Result<string, string> x) -> Result<string, string> {
    let m: HashMap<string, Result<string, string>> = HashMap::new();
    m.insert("k", x);
    for e in m {
        return e.value;
    }
    return x;
}

fn main() {
    let a: Result<string, string> = Ok("one");
    let b: Result<string, string> = Err("bad");
    println(say(entried(a)))?;
    println(say(entried(b)))?;
}
