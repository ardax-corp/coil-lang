// @expected E0801 — red in the representation matrix baseline (value-type, #1912)
//
// Representation matrix cell result_unit x hashmap_entry: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

fn say(Result<(), string> v) -> string {
    return match v {
        Ok(_) => "ok",
        Err(e) => "err " + e,
    };
}

fn entried(Result<(), string> x) -> Result<(), string> {
    let m: HashMap<string, Result<(), string>> = HashMap::new();
    m.insert("k", x);
    for e in m {
        return e.value;
    }
    return x;
}

fn main() {
    let a: Result<(), string> = Ok(());
    let b: Result<(), string> = Err("bad");
    println(say(entried(a)))?;
    println(say(entried(b)))?;
}
