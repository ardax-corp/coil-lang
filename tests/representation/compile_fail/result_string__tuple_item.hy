// @expected E0801 — red in the representation matrix baseline (let-pattern-layout)
//
// Representation matrix cell result_string x tuple_item: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<string, string> v) -> string {
    return match v {
        Ok(s) => "ok " + s,
        Err(e) => "err " + e,
    };
}

fn tupled<W>(W w) -> (W, int) {
    return (w, 1);
}

fn untupled(Result<string, string> x) -> Result<string, string> {
    let (y, _) = tupled(x);
    return y;
}

fn main() {
    let a: Result<string, string> = Ok("one");
    let b: Result<string, string> = Err("bad");
    println(say(untupled(a)))?;
    println(say(untupled(b)))?;
}
