// @expected E0801 — red in the representation matrix baseline (open-niche-element, #1896)
//
// Representation matrix cell result_unit x vec_field_local: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<(), string> v) -> string {
    return match v {
        Ok(_) => "ok",
        Err(e) => "err " + e,
    };
}

class Box<V> {
    pub v: V,
    pub vs: Vec<V>,
}

impl Box<V> {
    pub fn put(V x) {
        self.v = x;
        self.vs.push(x);
    }

    pub fn get() -> V {
        return self.v;
    }

    pub fn at(int i) -> V {
        return self.vs[i];
    }
}

fn boxed(Result<(), string> x) -> Box<Result<(), string>> {
    let vs: Vec<Result<(), string>> = Vec::new();
    let c = new Box(x, vs);
    c.put(x);
    return c;
}

fn first(Vec<Result<(), string>> w) -> Result<(), string> {
    return w[0];
}

fn main() {
    let a: Result<(), string> = Ok(());
    let b: Result<(), string> = Err("bad");
    println(say(first(boxed(a).vs)))?;
    println(say(first(boxed(b).vs)))?;
}
