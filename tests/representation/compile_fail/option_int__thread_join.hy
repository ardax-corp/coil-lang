// @expected E0801 — red in the representation matrix baseline (lambda-capture)
//
// Representation matrix cell option_int x thread_join: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;
use thread::{join, spawn};

fn say(Option<int> v) -> string {
    return match v {
        Some(n) => format("some %i", n),
        None => "none",
    };
}

fn threaded(Option<int> x) -> Option<int> {
    let th = match spawn(fn () use (x) => x) {
        Ok(t) => t,
        Err(_) => panic "spawn",
    };
    // `Thread` is untyped: pin the joined value's type, or a
    // result-mode `return` wraps it as the `Ok` payload.
    let got: Option<int> = match join(th) {
        Ok(v) => v,
        Err(_) => panic "join",
    };
    return got;
}

fn main() {
    let a: Option<int> = Some(7);
    let b: Option<int> = None;
    println(say(threaded(a)))?;
    println(say(threaded(b)))?;
}
