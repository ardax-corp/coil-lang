// @output str one\nstr two\n
//
// Representation matrix cell string x record_field: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(string v) -> string {
    return "str " + v;
}

fn recorded(string x) -> string {
    let r = { v: x, n: 1 };
    return r.v;
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(say(recorded(a)))?;
    println(say(recorded(b)))?;
}
