// @output held 4\ngone\n
//
// Representation matrix cell drop_enum x thread_join: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;
use thread::{join, spawn};

#[derive(Eq, Hash, Show)]
enum Res {
    Held(int),
    Gone,
}

impl Res {
    fn drop() {}
}

fn say(Res v) -> string {
    return match v {
        Res::Held(n) => format("held %i", n),
        Res::Gone => "gone",
    };
}

fn threaded(Res x) -> Res {
    let th = match spawn(fn () use (x) => x) {
        Ok(t) => t,
        Err(_) => panic "spawn",
    };
    return match join(th) {
        Ok(v) => v,
        Err(_) => panic "join",
    };
}

fn main() {
    let a: Res = Res::Held(4);
    let b: Res = Res::Gone;
    println(say(threaded(a)))?;
    println(say(threaded(b)))?;
}
