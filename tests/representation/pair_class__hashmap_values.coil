// @output p 1.5 2.0\np 0.5 4.0\n
//
// Representation matrix cell pair_class x hashmap_values: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

readonly class P {
    pub x: float,
    pub y: float,
}

fn say(P v) -> string {
    return format("p %v %v", v.x, v.y);
}

fn valued(P x) -> P {
    let m: HashMap<string, P> = HashMap::new();
    m.insert("k", x);
    return m.values()[0];
}

fn main() {
    let a: P = new P(1.5, 2.0);
    let b: P = new P(0.5, 4.0);
    println(say(valued(a)))?;
    println(say(valued(b)))?;
}
