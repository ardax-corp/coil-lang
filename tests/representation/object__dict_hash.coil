// @output true\ntrue\n
//
// Representation matrix cell object x dict_hash: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
class Obj {
    pub n: int,
}

fn say(Obj v) -> string {
    return format("obj %i", v.n);
}

fn hashed<W: Hash>(W w) -> int {
    return w.hash();
}

fn main() {
    let a: Obj = new Obj(1);
    let b: Obj = new Obj(2);
    println(format("%v", hashed(a) == a.hash()))?;
    println(format("%v", hashed(b) == b.hash()))?;
}
