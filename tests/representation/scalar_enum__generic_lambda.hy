// @output high\nlow\n
//
// Representation matrix cell scalar_enum x generic_lambda: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[repr(int)]
#[derive(Eq, Hash, Show)]
enum Lvl {
    Low = 1,
    High = 2,
}

fn say(Lvl v) -> string {
    return match v {
        Lvl::Low => "low",
        Lvl::High => "high",
    };
}

fn apply<W>(W w, W -> string f) -> string {
    return f(w);
}

fn main() {
    let a: Lvl = Lvl::High;
    let b: Lvl = Lvl::Low;
    println(apply(a, say))?;
    println(apply(b, say))?;
}
