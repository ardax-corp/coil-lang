// @output obj 1\nobj 2\n
//
// Representation matrix cell object x ground_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
class Obj {
    pub n: int,
}

fn say(Obj v) -> string {
    return format("obj %i", v.n);
}

fn pass(Obj v) -> Obj {
    let w = v;
    return w;
}

fn main() {
    let a: Obj = new Obj(1);
    let b: Obj = new Obj(2);
    println(say(pass(a)))?;
    println(say(pass(b)))?;
}
