// @output ok\nerr bad\n
//
// Representation matrix cell result_unit x bounded_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<(), string> v) -> string {
    return match v {
        Ok(_) => "ok",
        Err(e) => "err " + e,
    };
}

class KBox<K, V> {
    pub ks: Vec<K>,
    pub vs: Vec<V>,
}

impl KBox<K: Eq, V> {
    pub fn put(K k, V x) {
        self.ks.push(k);
        self.vs.push(x);
    }

    pub fn get(K k) -> V {
        let i = 0;
        while i < self.ks.len() - 1 && self.ks[i] != k {
            i = i + 1;
        }
        return self.vs[i];
    }
}

fn kboxed(Result<(), string> x) -> KBox<string, Result<(), string>> {
    let ks: Vec<string> = Vec::new();
    let vs: Vec<Result<(), string>> = Vec::new();
    let c = new KBox(ks, vs);
    c.put("k", x);
    return c;
}

fn main() {
    let a: Result<(), string> = Ok(());
    let b: Result<(), string> = Err("bad");
    println(say(kboxed(a).get("k")))?;
    println(say(kboxed(b).get("k")))?;
}
