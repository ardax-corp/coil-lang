// @output high\nlow\n
//
// Representation matrix cell scalar_enum x ground_return: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[repr(int)]
#[derive(Eq, Hash, Show)]
enum Lvl {
    Low = 1,
    High = 2,
}

fn say(Lvl v) -> string {
    return match v {
        Lvl::Low => "low",
        Lvl::High => "high",
    };
}

fn made_a() -> Lvl {
    return Lvl::High;
}

fn made_b() -> Lvl {
    return Lvl::Low;
}

fn main() {
    let a: Lvl = Lvl::High;
    let b: Lvl = Lvl::Low;
    println(say(made_a()))?;
    println(say(made_b()))?;
}
