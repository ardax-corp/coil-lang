// @output str one\nstr two\n
//
// Representation matrix cell string x host_pop: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(string v) -> string {
    return "str " + v;
}

fn popped(string x) -> string {
    let vs: Vec<string> = [x];
    return match vs.pop() {
        Some(v) => v,
        None => panic "empty",
    };
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(say(popped(a)))?;
    println(say(popped(b)))?;
}
