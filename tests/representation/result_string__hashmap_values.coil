// @output ok one\nerr bad\n
//
// Representation matrix cell result_string x hashmap_values: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

fn say(Result<string, string> v) -> string {
    return match v {
        Ok(s) => "ok " + s,
        Err(e) => "err " + e,
    };
}

fn valued(Result<string, string> x) -> Result<string, string> {
    let m: HashMap<string, Result<string, string>> = HashMap::new();
    m.insert("k", x);
    return m.values()[0];
}

fn main() {
    let a: Result<string, string> = Ok("one");
    let b: Result<string, string> = Err("bad");
    println(say(valued(a)))?;
    println(say(valued(b)))?;
}
