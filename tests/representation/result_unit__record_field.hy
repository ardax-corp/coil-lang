// @output ok\nerr bad\n
//
// Representation matrix cell result_unit x record_field: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<(), string> v) -> string {
    return match v {
        Ok(_) => "ok",
        Err(e) => "err " + e,
    };
}

fn recorded(Result<(), string> x) -> Result<(), string> {
    let r = { v: x, n: 1 };
    return r.v;
}

fn main() {
    let a: Result<(), string> = Ok(());
    let b: Result<(), string> = Err("bad");
    println(say(recorded(a)))?;
    println(say(recorded(b)))?;
}
