// @output true\ntrue\n
//
// Representation matrix cell string x dict_show: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(string v) -> string {
    return "str " + v;
}

fn shown<W: Show>(W w) -> string {
    return w.show();
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(format("%v", shown(a) == a.show()))?;
    println(format("%v", shown(b) == b.show()))?;
}
