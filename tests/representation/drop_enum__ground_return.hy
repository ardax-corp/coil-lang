// @output held 4\ngone\n
//
// Representation matrix cell drop_enum x ground_return: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
enum Res {
    Held(int),
    Gone,
}

impl Res {
    fn drop() {}
}

fn say(Res v) -> string {
    return match v {
        Res::Held(n) => format("held %i", n),
        Res::Gone => "gone",
    };
}

fn made_a() -> Res {
    return Res::Held(4);
}

fn made_b() -> Res {
    return Res::Gone;
}

fn main() {
    let a: Res = Res::Held(4);
    let b: Res = Res::Gone;
    println(say(made_a()))?;
    println(say(made_b()))?;
}
