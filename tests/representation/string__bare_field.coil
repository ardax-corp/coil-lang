// @output str one\nstr two\n
//
// Representation matrix cell string x bare_field: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(string v) -> string {
    return "str " + v;
}

class Box<V> {
    pub v: V,
    pub vs: Vec<V>,
}

impl Box<V> {
    pub fn put(V x) {
        self.v = x;
        self.vs.push(x);
    }

    pub fn get() -> V {
        return self.v;
    }

    pub fn at(int i) -> V {
        return self.vs[i];
    }
}

fn boxed(string x) -> Box<string> {
    let vs: Vec<string> = Vec::new();
    let c = new Box(x, vs);
    c.put(x);
    return c;
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(say(boxed(a).v))?;
    println(say(boxed(b).v))?;
}
