// @output some some one\nsome none\n
//
// Representation matrix cell option_option x host_pop: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<Option<string>> v) -> string {
    return match v {
        Some(Some(s)) => "some some " + s,
        Some(None) => "some none",
        None => "none",
    };
}

fn popped(Option<Option<string>> x) -> Option<Option<string>> {
    let vs: Vec<Option<Option<string>>> = [x];
    return match vs.pop() {
        Some(v) => v,
        None => panic "empty",
    };
}

fn main() {
    let a: Option<Option<string>> = Some(Some("one"));
    let b: Option<Option<string>> = Some(None);
    println(say(popped(a)))?;
    println(say(popped(b)))?;
}
