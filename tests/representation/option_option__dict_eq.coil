// @output true false\ntrue false\n
//
// Representation matrix cell option_option x dict_eq: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<Option<string>> v) -> string {
    return match v {
        Some(Some(s)) => "some some " + s,
        Some(None) => "some none",
        None => "none",
    };
}

fn same<W: Eq>(W a, W b) -> bool {
    return a == b;
}

fn main() {
    let a: Option<Option<string>> = Some(Some("one"));
    let b: Option<Option<string>> = Some(None);
    println(format("%v %v", same(a, a), same(a, b)))?;
    println(format("%v %v", same(b, b), same(b, a)))?;
}
