// @output int 7\nint -3\n
//
// Representation matrix cell int x thread_join: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;
use thread::{join, spawn};

fn say(int v) -> string {
    return format("int %i", v);
}

fn threaded(int x) -> int {
    let th = match spawn(fn () use (x) => x) {
        Ok(t) => t,
        Err(_) => panic "spawn",
    };
    return match join(th) {
        Ok(v) => v,
        Err(_) => panic "join",
    };
}

fn main() {
    let a: int = 7;
    let b: int = -3;
    println(say(threaded(a)))?;
    println(say(threaded(b)))?;
}
