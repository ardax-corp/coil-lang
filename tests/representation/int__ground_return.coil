// @output int 7\nint -3\n
//
// Representation matrix cell int x ground_return: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(int v) -> string {
    return format("int %i", v);
}

fn made_a() -> int {
    return 7;
}

fn made_b() -> int {
    return -3;
}

fn main() {
    let a: int = 7;
    let b: int = -3;
    println(say(made_a()))?;
    println(say(made_b()))?;
}
