// @output some some one\nsome none\n
//
// Representation matrix cell option_option x closure_capture: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<Option<string>> v) -> string {
    return match v {
        Some(Some(s)) => "some some " + s,
        Some(None) => "some none",
        None => "none",
    };
}

fn captured(Option<Option<string>> x) -> Option<Option<string>> {
    let f = fn () use (x) => x;
    return f();
}

fn main() {
    let a: Option<Option<string>> = Some(Some("one"));
    let b: Option<Option<string>> = Some(None);
    println(say(captured(a)))?;
    println(say(captured(b)))?;
}
