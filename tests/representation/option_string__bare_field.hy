// @output some one\nnone\n
//
// Representation matrix cell option_string x bare_field: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<string> v) -> string {
    return match v {
        Some(s) => "some " + s,
        None => "none",
    };
}

class Box<V> {
    pub v: V,
    pub vs: Vec<V>,
}

impl Box<V> {
    pub fn put(V x) {
        self.v = x;
        self.vs.push(x);
    }

    pub fn get() -> V {
        return self.v;
    }

    pub fn at(int i) -> V {
        return self.vs[i];
    }
}

fn boxed(Option<string> x) -> Box<Option<string>> {
    let vs: Vec<Option<string>> = Vec::new();
    let c = new Box(x, vs);
    c.put(x);
    return c;
}

fn main() {
    let a: Option<string> = Some("one");
    let b: Option<string> = None;
    println(say(boxed(a).v))?;
    println(say(boxed(b).v))?;
}
