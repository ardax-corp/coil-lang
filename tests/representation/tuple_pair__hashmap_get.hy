// @output tuple 1 2.5\ntuple 3 0.5\n
//
// Representation matrix cell tuple_pair x hashmap_get: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

fn say((int, float) v) -> string {
    let (x, y) = v;
    return format("tuple %i %v", x, y);
}

fn mapped((int, float) x) -> (int, float) {
    let m: HashMap<string, (int, float)> = HashMap::new();
    m.insert("k", x);
    return m.get("k", x);
}

fn main() {
    let a: (int, float) = (1, 2.5);
    let b: (int, float) = (3, 0.5);
    println(say(mapped(a)))?;
    println(say(mapped(b)))?;
}
