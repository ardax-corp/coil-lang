// @output some one\nnone\n
//
// Representation matrix cell option_string x closure_capture: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<string> v) -> string {
    return match v {
        Some(s) => "some " + s,
        None => "none",
    };
}

fn captured(Option<string> x) -> Option<string> {
    let f = fn () use (x) => x;
    return f();
}

fn main() {
    let a: Option<string> = Some("one");
    let b: Option<string> = None;
    println(say(captured(a)))?;
    println(say(captured(b)))?;
}
