// @output ok\nerr bad\n
//
// Representation matrix cell result_unit x host_pop: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<(), string> v) -> string {
    return match v {
        Ok(_) => "ok",
        Err(e) => "err " + e,
    };
}

fn popped(Result<(), string> x) -> Result<(), string> {
    let vs: Vec<Result<(), string>> = [x];
    return match vs.pop() {
        Some(v) => v,
        None => panic "empty",
    };
}

fn main() {
    let a: Result<(), string> = Ok(());
    let b: Result<(), string> = Err("bad");
    println(say(popped(a)))?;
    println(say(popped(b)))?;
}
