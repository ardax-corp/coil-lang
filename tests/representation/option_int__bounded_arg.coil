// @output some 7\nnone\n
//
// Representation matrix cell option_int x bounded_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<int> v) -> string {
    return match v {
        Some(n) => format("some %i", n),
        None => "none",
    };
}

class KBox<K, V> {
    pub ks: Vec<K>,
    pub vs: Vec<V>,
}

impl KBox<K: Eq, V> {
    pub fn put(K k, V x) {
        self.ks.push(k);
        self.vs.push(x);
    }

    pub fn get(K k) -> V {
        let i = 0;
        while i < self.ks.len() - 1 && self.ks[i] != k {
            i = i + 1;
        }
        return self.vs[i];
    }
}

fn kboxed(Option<int> x) -> KBox<string, Option<int>> {
    let ks: Vec<string> = Vec::new();
    let vs: Vec<Option<int>> = Vec::new();
    let c = new KBox(ks, vs);
    c.put("k", x);
    return c;
}

fn main() {
    let a: Option<int> = Some(7);
    let b: Option<int> = None;
    println(say(kboxed(a).get("k")))?;
    println(say(kboxed(b).get("k")))?;
}
