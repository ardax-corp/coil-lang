// @output ok\nerr bad\n
//
// Representation matrix cell result_unit x ground_return: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<(), string> v) -> string {
    return match v {
        Ok(_) => "ok",
        Err(e) => "err " + e,
    };
}

fn made_a() -> Result<(), string> {
    return Ok(());
}

fn made_b() -> Result<(), string> {
    return Err("bad");
}

fn main() {
    let a: Result<(), string> = Ok(());
    let b: Result<(), string> = Err("bad");
    println(say(made_a()))?;
    println(say(made_b()))?;
}
