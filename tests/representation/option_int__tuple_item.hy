// @output some 7\nnone\n
//
// Representation matrix cell option_int x tuple_item: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<int> v) -> string {
    return match v {
        Some(n) => format("some %i", n),
        None => "none",
    };
}

fn tupled<W>(W w) -> (W, int) {
    return (w, 1);
}

fn untupled(Option<int> x) -> Option<int> {
    let (y, _) = tupled(x);
    return y;
}

fn main() {
    let a: Option<int> = Some(7);
    let b: Option<int> = None;
    println(say(untupled(a)))?;
    println(say(untupled(b)))?;
}
