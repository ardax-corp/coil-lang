// @output some 7\nnone\n
//
// Representation matrix cell option_int x record_field: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<int> v) -> string {
    return match v {
        Some(n) => format("some %i", n),
        None => "none",
    };
}

fn recorded(Option<int> x) -> Option<int> {
    let r = { v: x, n: 1 };
    return r.v;
}

fn main() {
    let a: Option<int> = Some(7);
    let b: Option<int> = None;
    println(say(recorded(a)))?;
    println(say(recorded(b)))?;
}
