// @output int 7\nint -3\n
//
// Representation matrix cell int x record_field: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(int v) -> string {
    return format("int %i", v);
}

fn recorded(int x) -> int {
    let r = { v: x, n: 1 };
    return r.v;
}

fn main() {
    let a: int = 7;
    let b: int = -3;
    println(say(recorded(a)))?;
    println(say(recorded(b)))?;
}
