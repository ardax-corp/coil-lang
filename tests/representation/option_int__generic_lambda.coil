// @output some 7\nnone\n
//
// Representation matrix cell option_int x generic_lambda: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<int> v) -> string {
    return match v {
        Some(n) => format("some %i", n),
        None => "none",
    };
}

fn apply<W>(W w, W -> string f) -> string {
    return f(w);
}

fn main() {
    let a: Option<int> = Some(7);
    let b: Option<int> = None;
    println(apply(a, say))?;
    println(apply(b, say))?;
}
