// @output true\ntrue\n
//
// Representation matrix cell drop_enum x dict_show: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
enum Res {
    Held(int),
    Gone,
}

impl Res {
    fn drop() {}
}

fn say(Res v) -> string {
    return match v {
        Res::Held(n) => format("held %i", n),
        Res::Gone => "gone",
    };
}

fn shown<W: Show>(W w) -> string {
    return w.show();
}

fn main() {
    let a: Res = Res::Held(4);
    let b: Res = Res::Gone;
    println(format("%v", shown(a) == a.show()))?;
    println(format("%v", shown(b) == b.show()))?;
}
