// @output true\ntrue\n
//
// Representation matrix cell tuple_pair x dict_show: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say((int, float) v) -> string {
    let (x, y) = v;
    return format("tuple %i %v", x, y);
}

fn shown<W: Show>(W w) -> string {
    return w.show();
}

fn main() {
    let a: (int, float) = (1, 2.5);
    let b: (int, float) = (3, 0.5);
    println(format("%v", shown(a) == a.show()))?;
    println(format("%v", shown(b) == b.show()))?;
}
