// @output high\nlow\n
//
// Representation matrix cell scalar_enum x thread_join: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;
use thread::{join, spawn};

#[repr(int)]
#[derive(Eq, Hash, Show)]
enum Lvl {
    Low = 1,
    High = 2,
}

fn say(Lvl v) -> string {
    return match v {
        Lvl::Low => "low",
        Lvl::High => "high",
    };
}

fn threaded(Lvl x) -> Lvl {
    let th = match spawn(fn () use (x) => x) {
        Ok(t) => t,
        Err(_) => panic "spawn",
    };
    // `Thread` is untyped: pin the joined value's type, or a
    // result-mode `return` wraps it as the `Ok` payload.
    let got: Lvl = match join(th) {
        Ok(v) => v,
        Err(_) => panic "join",
    };
    return got;
}

fn main() {
    let a: Lvl = Lvl::High;
    let b: Lvl = Lvl::Low;
    println(say(threaded(a)))?;
    println(say(threaded(b)))?;
}
