// @output obj 1\nobj 2\n
//
// Representation matrix cell object x generic_lambda: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
class Obj {
    pub n: int,
}

fn say(Obj v) -> string {
    return format("obj %i", v.n);
}

fn apply<W>(W w, W -> string f) -> string {
    return f(w);
}

fn main() {
    let a: Obj = new Obj(1);
    let b: Obj = new Obj(2);
    println(apply(a, say))?;
    println(apply(b, say))?;
}
