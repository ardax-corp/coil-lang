// @output some 7\nnone\n
//
// Representation matrix cell option_int x ground_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<int> v) -> string {
    return match v {
        Some(n) => format("some %i", n),
        None => "none",
    };
}

fn pass(Option<int> v) -> Option<int> {
    let w = v;
    return w;
}

fn main() {
    let a: Option<int> = Some(7);
    let b: Option<int> = None;
    println(say(pass(a)))?;
    println(say(pass(b)))?;
}
