// @output ok one\nerr bad\n
//
// Representation matrix cell result_string x host_pop: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<string, string> v) -> string {
    return match v {
        Ok(s) => "ok " + s,
        Err(e) => "err " + e,
    };
}

fn popped(Result<string, string> x) -> Result<string, string> {
    let vs: Vec<Result<string, string>> = [x];
    return match vs.pop() {
        Some(v) => v,
        None => panic "empty",
    };
}

fn main() {
    let a: Result<string, string> = Ok("one");
    let b: Result<string, string> = Err("bad");
    println(say(popped(a)))?;
    println(say(popped(b)))?;
}
