// @output ok one\nerr bad\n
//
// Representation matrix cell result_string x generic_lambda: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<string, string> v) -> string {
    return match v {
        Ok(s) => "ok " + s,
        Err(e) => "err " + e,
    };
}

fn apply<W>(W w, W -> string f) -> string {
    return f(w);
}

fn main() {
    let a: Result<string, string> = Ok("one");
    let b: Result<string, string> = Err("bad");
    println(apply(a, say))?;
    println(apply(b, say))?;
}
