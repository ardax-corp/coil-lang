// @output obj 1\nobj 2\n
//
// Representation matrix cell object x record_field: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
class Obj {
    pub n: int,
}

fn say(Obj v) -> string {
    return format("obj %i", v.n);
}

fn recorded(Obj x) -> Obj {
    let r = { v: x, n: 1 };
    return r.v;
}

fn main() {
    let a: Obj = new Obj(1);
    let b: Obj = new Obj(2);
    println(say(recorded(a)))?;
    println(say(recorded(b)))?;
}
