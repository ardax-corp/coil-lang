// @output some 7\nnone\n
//
// Representation matrix cell option_int x ground_return: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<int> v) -> string {
    return match v {
        Some(n) => format("some %i", n),
        None => "none",
    };
}

fn made_a() -> Option<int> {
    return Some(7);
}

fn made_b() -> Option<int> {
    return None;
}

fn main() {
    let a: Option<int> = Some(7);
    let b: Option<int> = None;
    println(say(made_a()))?;
    println(say(made_b()))?;
}
