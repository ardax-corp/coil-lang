// @output obj 1\nobj 2\n
//
// Representation matrix cell object x hashmap_get: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
class Obj {
    pub n: int,
}

fn say(Obj v) -> string {
    return format("obj %i", v.n);
}

fn mapped(Obj x) -> Obj {
    let m: HashMap<string, Obj> = HashMap::new();
    m.insert("k", x);
    return m.get("k", x);
}

fn main() {
    let a: Obj = new Obj(1);
    let b: Obj = new Obj(2);
    println(say(mapped(a)))?;
    println(say(mapped(b)))?;
}
