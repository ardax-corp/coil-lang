// @output some one\nnone\n
//
// Representation matrix cell option_string x ground_return: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<string> v) -> string {
    return match v {
        Some(s) => "some " + s,
        None => "none",
    };
}

fn made_a() -> Option<string> {
    return Some("one");
}

fn made_b() -> Option<string> {
    return None;
}

fn main() {
    let a: Option<string> = Some("one");
    let b: Option<string> = None;
    println(say(made_a()))?;
    println(say(made_b()))?;
}
