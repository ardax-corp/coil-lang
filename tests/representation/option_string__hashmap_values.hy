// @output some one\nnone\n
//
// Representation matrix cell option_string x hashmap_values: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

fn say(Option<string> v) -> string {
    return match v {
        Some(s) => "some " + s,
        None => "none",
    };
}

fn valued(Option<string> x) -> Option<string> {
    let m: HashMap<string, Option<string>> = HashMap::new();
    m.insert("k", x);
    return m.values()[0];
}

fn main() {
    let a: Option<string> = Some("one");
    let b: Option<string> = None;
    println(say(valued(a)))?;
    println(say(valued(b)))?;
}
