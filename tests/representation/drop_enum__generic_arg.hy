// @output held 4\ngone\n
//
// Representation matrix cell drop_enum x generic_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
enum Res {
    Held(int),
    Gone,
}

impl Res {
    fn drop() {}
}

fn say(Res v) -> string {
    return match v {
        Res::Held(n) => format("held %i", n),
        Res::Gone => "gone",
    };
}

class Box<V> {
    pub v: V,
    pub vs: Vec<V>,
}

impl Box<V> {
    pub fn put(V x) {
        self.v = x;
        self.vs.push(x);
    }

    pub fn get() -> V {
        return self.v;
    }

    pub fn at(int i) -> V {
        return self.vs[i];
    }
}

fn boxed(Res x) -> Box<Res> {
    let vs: Vec<Res> = Vec::new();
    let c = new Box(x, vs);
    c.put(x);
    return c;
}

fn main() {
    let a: Res = Res::Held(4);
    let b: Res = Res::Gone;
    println(say(boxed(a).at(0)))?;
    println(say(boxed(b).at(0)))?;
}
