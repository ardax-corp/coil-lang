// @output some one\nnone\n
//
// Representation matrix cell option_string x tuple_item: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<string> v) -> string {
    return match v {
        Some(s) => "some " + s,
        None => "none",
    };
}

fn tupled<W>(W w) -> (W, int) {
    return (w, 1);
}

fn untupled(Option<string> x) -> Option<string> {
    let (y, _) = tupled(x);
    return y;
}

fn main() {
    let a: Option<string> = Some("one");
    let b: Option<string> = None;
    println(say(untupled(a)))?;
    println(say(untupled(b)))?;
}
