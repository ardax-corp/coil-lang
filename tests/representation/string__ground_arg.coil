// @output str one\nstr two\n
//
// Representation matrix cell string x ground_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(string v) -> string {
    return "str " + v;
}

fn pass(string v) -> string {
    let w = v;
    return w;
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(say(pass(a)))?;
    println(say(pass(b)))?;
}
