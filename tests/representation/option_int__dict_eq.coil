// @output true false\ntrue false\n
//
// Representation matrix cell option_int x dict_eq: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<int> v) -> string {
    return match v {
        Some(n) => format("some %i", n),
        None => "none",
    };
}

fn same<W: Eq>(W a, W b) -> bool {
    return a == b;
}

fn main() {
    let a: Option<int> = Some(7);
    let b: Option<int> = None;
    println(format("%v %v", same(a, a), same(a, b)))?;
    println(format("%v %v", same(b, b), same(b, a)))?;
}
