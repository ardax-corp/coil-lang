// @output high\nlow\n
//
// Representation matrix cell scalar_enum x closure_capture: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[repr(int)]
#[derive(Eq, Hash, Show)]
enum Lvl {
    Low = 1,
    High = 2,
}

fn say(Lvl v) -> string {
    return match v {
        Lvl::Low => "low",
        Lvl::High => "high",
    };
}

fn captured(Lvl x) -> Lvl {
    let f = fn () use (x) => x;
    return f();
}

fn main() {
    let a: Lvl = Lvl::High;
    let b: Lvl = Lvl::Low;
    println(say(captured(a)))?;
    println(say(captured(b)))?;
}
