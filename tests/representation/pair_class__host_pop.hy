// @output p 1.5 2.0\np 0.5 4.0\n
//
// Representation matrix cell pair_class x host_pop: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

readonly class P {
    pub x: float,
    pub y: float,
}

fn say(P v) -> string {
    return format("p %v %v", v.x, v.y);
}

fn popped(P x) -> P {
    let vs: Vec<P> = [x];
    return match vs.pop() {
        Some(v) => v,
        None => panic "empty",
    };
}

fn main() {
    let a: P = new P(1.5, 2.0);
    let b: P = new P(0.5, 4.0);
    println(say(popped(a)))?;
    println(say(popped(b)))?;
}
