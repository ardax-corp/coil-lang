// @output int 7\nint -3\n
//
// Representation matrix cell int x ground_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(int v) -> string {
    return format("int %i", v);
}

fn pass(int v) -> int {
    let w = v;
    return w;
}

fn main() {
    let a: int = 7;
    let b: int = -3;
    println(say(pass(a)))?;
    println(say(pass(b)))?;
}
