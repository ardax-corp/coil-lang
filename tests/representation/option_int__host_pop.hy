// @output some 7\nnone\n
//
// Representation matrix cell option_int x host_pop: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<int> v) -> string {
    return match v {
        Some(n) => format("some %i", n),
        None => "none",
    };
}

fn popped(Option<int> x) -> Option<int> {
    let vs: Vec<Option<int>> = [x];
    return match vs.pop() {
        Some(v) => v,
        None => panic "empty",
    };
}

fn main() {
    let a: Option<int> = Some(7);
    let b: Option<int> = None;
    println(say(popped(a)))?;
    println(say(popped(b)))?;
}
