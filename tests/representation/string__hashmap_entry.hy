// @output str one\nstr two\n
//
// Representation matrix cell string x hashmap_entry: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

fn say(string v) -> string {
    return "str " + v;
}

fn entried(string x) -> string {
    let m: HashMap<string, string> = HashMap::new();
    m.insert("k", x);
    for e in m {
        return e.value;
    }
    return x;
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(say(entried(a)))?;
    println(say(entried(b)))?;
}
