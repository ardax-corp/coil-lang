// @output some some one\nsome none\n
//
// Representation matrix cell option_option x bounded_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<Option<string>> v) -> string {
    return match v {
        Some(Some(s)) => "some some " + s,
        Some(None) => "some none",
        None => "none",
    };
}

class KBox<K, V> {
    pub ks: Vec<K>,
    pub vs: Vec<V>,
}

impl KBox<K: Eq, V> {
    pub fn put(K k, V x) {
        self.ks.push(k);
        self.vs.push(x);
    }

    pub fn get(K k) -> V {
        let i = 0;
        while i < self.ks.len() - 1 && self.ks[i] != k {
            i = i + 1;
        }
        return self.vs[i];
    }
}

fn kboxed(Option<Option<string>> x) -> KBox<string, Option<Option<string>>> {
    let ks: Vec<string> = Vec::new();
    let vs: Vec<Option<Option<string>>> = Vec::new();
    let c = new KBox(ks, vs);
    c.put("k", x);
    return c;
}

fn main() {
    let a: Option<Option<string>> = Some(Some("one"));
    let b: Option<Option<string>> = Some(None);
    println(say(kboxed(a).get("k")))?;
    println(say(kboxed(b).get("k")))?;
}
