use io::sync::println;
use string::format;

fn say(string v) -> string {
    return "str " + v;
}

fn made_a() -> string {
    return "one";
}

fn made_b() -> string {
    return "two";
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(say(made_a()))?;
    println(say(made_b()))?;
}
