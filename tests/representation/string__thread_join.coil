// @output str one\nstr two\n
//
// Representation matrix cell string x thread_join: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;
use thread::{join, spawn};

fn say(string v) -> string {
    return "str " + v;
}

fn threaded(string x) -> string {
    let th = match spawn(fn () use (x) => x) {
        Ok(t) => t,
        Err(_) => panic "spawn",
    };
    // `Thread` is untyped: pin the joined value's type, or a
    // result-mode `return` wraps it as the `Ok` payload.
    let got: string = match join(th) {
        Ok(v) => v,
        Err(_) => panic "join",
    };
    return got;
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(say(threaded(a)))?;
    println(say(threaded(b)))?;
}
