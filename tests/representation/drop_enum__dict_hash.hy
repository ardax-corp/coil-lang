// @output true\ntrue\n
//
// Representation matrix cell drop_enum x dict_hash: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
enum Res {
    Held(int),
    Gone,
}

impl Res {
    fn drop() {}
}

fn say(Res v) -> string {
    return match v {
        Res::Held(n) => format("held %i", n),
        Res::Gone => "gone",
    };
}

fn hashed<W: Hash>(W w) -> int {
    return w.hash();
}

fn main() {
    let a: Res = Res::Held(4);
    let b: Res = Res::Gone;
    println(format("%v", hashed(a) == a.hash()))?;
    println(format("%v", hashed(b) == b.hash()))?;
}
