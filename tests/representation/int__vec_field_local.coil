// @output int 7\nint -3\n
//
// Representation matrix cell int x vec_field_local: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(int v) -> string {
    return format("int %i", v);
}

class Box<V> {
    pub v: V,
    pub vs: Vec<V>,
}

impl Box<V> {
    pub fn put(V x) {
        self.v = x;
        self.vs.push(x);
    }

    pub fn get() -> V {
        return self.v;
    }

    pub fn at(int i) -> V {
        return self.vs[i];
    }
}

fn boxed(int x) -> Box<int> {
    let vs: Vec<int> = Vec::new();
    let c = new Box(x, vs);
    c.put(x);
    return c;
}

fn first(Vec<int> w) -> int {
    return w[0];
}

fn main() {
    let a: int = 7;
    let b: int = -3;
    println(say(first(boxed(a).vs)))?;
    println(say(first(boxed(b).vs)))?;
}
