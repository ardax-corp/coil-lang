// @output tuple 1 2.5\ntuple 3 0.5\n
//
// Representation matrix cell tuple_pair x tuple_item: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say((int, float) v) -> string {
    let (x, y) = v;
    return format("tuple %i %v", x, y);
}

fn tupled<W>(W w) -> (W, int) {
    return (w, 1);
}

fn untupled((int, float) x) -> (int, float) {
    let (y, _) = tupled(x);
    return y;
}

fn main() {
    let a: (int, float) = (1, 2.5);
    let b: (int, float) = (3, 0.5);
    println(say(untupled(a)))?;
    println(say(untupled(b)))?;
}
