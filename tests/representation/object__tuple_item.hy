// @output obj 1\nobj 2\n
//
// Representation matrix cell object x tuple_item: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
class Obj {
    pub n: int,
}

fn say(Obj v) -> string {
    return format("obj %i", v.n);
}

fn tupled<W>(W w) -> (W, int) {
    return (w, 1);
}

fn untupled(Obj x) -> Obj {
    let (y, _) = tupled(x);
    return y;
}

fn main() {
    let a: Obj = new Obj(1);
    let b: Obj = new Obj(2);
    println(say(untupled(a)))?;
    println(say(untupled(b)))?;
}
