// @output true\ntrue\n
//
// Representation matrix cell int x dict_show: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(int v) -> string {
    return format("int %i", v);
}

fn shown<W: Show>(W w) -> string {
    return w.show();
}

fn main() {
    let a: int = 7;
    let b: int = -3;
    println(format("%v", shown(a) == a.show()))?;
    println(format("%v", shown(b) == b.show()))?;
}
