// @output true false\ntrue false\n
//
// Representation matrix cell result_string x dict_eq: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<string, string> v) -> string {
    return match v {
        Ok(s) => "ok " + s,
        Err(e) => "err " + e,
    };
}

fn same<W: Eq>(W a, W b) -> bool {
    return a == b;
}

fn main() {
    let a: Result<string, string> = Ok("one");
    let b: Result<string, string> = Err("bad");
    println(format("%v %v", same(a, a), same(a, b)))?;
    println(format("%v %v", same(b, b), same(b, a)))?;
}
