// @output some some one\nsome none\n
//
// Representation matrix cell option_option x tuple_item: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<Option<string>> v) -> string {
    return match v {
        Some(Some(s)) => "some some " + s,
        Some(None) => "some none",
        None => "none",
    };
}

fn tupled<W>(W w) -> (W, int) {
    return (w, 1);
}

fn untupled(Option<Option<string>> x) -> Option<Option<string>> {
    let (y, _) = tupled(x);
    return y;
}

fn main() {
    let a: Option<Option<string>> = Some(Some("one"));
    let b: Option<Option<string>> = Some(None);
    println(say(untupled(a)))?;
    println(say(untupled(b)))?;
}
