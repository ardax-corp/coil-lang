// @output ok one\nerr bad\n
//
// Representation matrix cell result_string x ground_return: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<string, string> v) -> string {
    return match v {
        Ok(s) => "ok " + s,
        Err(e) => "err " + e,
    };
}

fn made_a() -> Result<string, string> {
    return Ok("one");
}

fn made_b() -> Result<string, string> {
    return Err("bad");
}

fn main() {
    let a: Result<string, string> = Ok("one");
    let b: Result<string, string> = Err("bad");
    println(say(made_a()))?;
    println(say(made_b()))?;
}
