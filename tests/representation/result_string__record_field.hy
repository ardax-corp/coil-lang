// @output ok one\nerr bad\n
//
// Representation matrix cell result_string x record_field: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<string, string> v) -> string {
    return match v {
        Ok(s) => "ok " + s,
        Err(e) => "err " + e,
    };
}

fn recorded(Result<string, string> x) -> Result<string, string> {
    let r = { v: x, n: 1 };
    return r.v;
}

fn main() {
    let a: Result<string, string> = Ok("one");
    let b: Result<string, string> = Err("bad");
    println(say(recorded(a)))?;
    println(say(recorded(b)))?;
}
