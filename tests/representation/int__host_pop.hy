// @output int 7\nint -3\n
//
// Representation matrix cell int x host_pop: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(int v) -> string {
    return format("int %i", v);
}

fn popped(int x) -> int {
    let vs: Vec<int> = [x];
    return match vs.pop() {
        Some(v) => v,
        None => panic "empty",
    };
}

fn main() {
    let a: int = 7;
    let b: int = -3;
    println(say(popped(a)))?;
    println(say(popped(b)))?;
}
