// @output true\ntrue\n
//
// Representation matrix cell pair_class x dict_hash: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

readonly class P {
    pub x: float,
    pub y: float,
}

fn say(P v) -> string {
    return format("p %v %v", v.x, v.y);
}

fn hashed<W: Hash>(W w) -> int {
    return w.hash();
}

fn main() {
    let a: P = new P(1.5, 2.0);
    let b: P = new P(0.5, 4.0);
    println(format("%v", hashed(a) == a.hash()))?;
    println(format("%v", hashed(b) == b.hash()))?;
}
