// @output tuple 1 2.5\ntuple 3 0.5\n
//
// Representation matrix cell tuple_pair x thread_join: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;
use thread::{join, spawn};

fn say((int, float) v) -> string {
    let (x, y) = v;
    return format("tuple %i %v", x, y);
}

fn threaded((int, float) x) -> (int, float) {
    let th = match spawn(fn () use (x) => x) {
        Ok(t) => t,
        Err(_) => panic "spawn",
    };
    return match join(th) {
        Ok(v) => v,
        Err(_) => panic "join",
    };
}

fn main() {
    let a: (int, float) = (1, 2.5);
    let b: (int, float) = (3, 0.5);
    println(say(threaded(a)))?;
    println(say(threaded(b)))?;
}
