// @output held 4\ngone\n
//
// Representation matrix cell drop_enum x hashmap_get: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
enum Res {
    Held(int),
    Gone,
}

impl Res {
    fn drop() {}
}

fn say(Res v) -> string {
    return match v {
        Res::Held(n) => format("held %i", n),
        Res::Gone => "gone",
    };
}

fn mapped(Res x) -> Res {
    let m: HashMap<string, Res> = HashMap::new();
    m.insert("k", x);
    return m.get_or("k", x);
}

fn main() {
    let a: Res = Res::Held(4);
    let b: Res = Res::Gone;
    println(say(mapped(a)))?;
    println(say(mapped(b)))?;
}
