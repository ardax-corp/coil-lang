// @output some 7\nnone\n
//
// Representation matrix cell option_int x hashmap_values: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

fn say(Option<int> v) -> string {
    return match v {
        Some(n) => format("some %i", n),
        None => "none",
    };
}

fn valued(Option<int> x) -> Option<int> {
    let m: HashMap<string, Option<int>> = HashMap::new();
    m.insert("k", x);
    return m.values()[0];
}

fn main() {
    let a: Option<int> = Some(7);
    let b: Option<int> = None;
    println(say(valued(a)))?;
    println(say(valued(b)))?;
}
