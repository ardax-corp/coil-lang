// @output ok\nerr bad\n
//
// Representation matrix cell result_unit x thread_join: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;
use thread::{join, spawn};

fn say(Result<(), string> v) -> string {
    return match v {
        Ok(_) => "ok",
        Err(e) => "err " + e,
    };
}

fn threaded(Result<(), string> x) -> Result<(), string> {
    let th = match spawn(fn () use (x) => x) {
        Ok(t) => t,
        Err(_) => panic "spawn",
    };
    // `Thread` is untyped: pin the joined value's type, or a
    // result-mode `return` wraps it as the `Ok` payload.
    let got: Result<(), string> = match join(th) {
        Ok(v) => v,
        Err(_) => panic "join",
    };
    return got;
}

fn main() {
    let a: Result<(), string> = Ok(());
    let b: Result<(), string> = Err("bad");
    println(say(threaded(a)))?;
    println(say(threaded(b)))?;
}
