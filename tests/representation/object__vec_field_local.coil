// @output obj 1\nobj 2\n
//
// Representation matrix cell object x vec_field_local: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
class Obj {
    pub n: int,
}

fn say(Obj v) -> string {
    return format("obj %i", v.n);
}

class Box<V> {
    pub v: V,
    pub vs: Vec<V>,
}

impl Box<V> {
    pub fn put(V x) {
        self.v = x;
        self.vs.push(x);
    }

    pub fn get() -> V {
        return self.v;
    }

    pub fn at(int i) -> V {
        return self.vs[i];
    }
}

fn boxed(Obj x) -> Box<Obj> {
    let vs: Vec<Obj> = Vec::new();
    let c = new Box(x, vs);
    c.put(x);
    return c;
}

fn first(Vec<Obj> w) -> Obj {
    return w[0];
}

fn main() {
    let a: Obj = new Obj(1);
    let b: Obj = new Obj(2);
    println(say(first(boxed(a).vs)))?;
    println(say(first(boxed(b).vs)))?;
}
