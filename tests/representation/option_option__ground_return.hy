// @output some some one\nsome none\n
//
// Representation matrix cell option_option x ground_return: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<Option<string>> v) -> string {
    return match v {
        Some(Some(s)) => "some some " + s,
        Some(None) => "some none",
        None => "none",
    };
}

fn made_a() -> Option<Option<string>> {
    return Some(Some("one"));
}

fn made_b() -> Option<Option<string>> {
    return Some(None);
}

fn main() {
    let a: Option<Option<string>> = Some(Some("one"));
    let b: Option<Option<string>> = Some(None);
    println(say(made_a()))?;
    println(say(made_b()))?;
}
