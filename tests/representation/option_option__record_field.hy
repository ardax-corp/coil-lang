// @output some some one\nsome none\n
//
// Representation matrix cell option_option x record_field: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<Option<string>> v) -> string {
    return match v {
        Some(Some(s)) => "some some " + s,
        Some(None) => "some none",
        None => "none",
    };
}

fn recorded(Option<Option<string>> x) -> Option<Option<string>> {
    let r = { v: x, n: 1 };
    return r.v;
}

fn main() {
    let a: Option<Option<string>> = Some(Some("one"));
    let b: Option<Option<string>> = Some(None);
    println(say(recorded(a)))?;
    println(say(recorded(b)))?;
}
