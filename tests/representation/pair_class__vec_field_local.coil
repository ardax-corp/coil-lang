// @output p 1.5 2.0\np 0.5 4.0\n
//
// Representation matrix cell pair_class x vec_field_local: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

readonly class P {
    pub x: float,
    pub y: float,
}

fn say(P v) -> string {
    return format("p %v %v", v.x, v.y);
}

class Box<V> {
    pub v: V,
    pub vs: Vec<V>,
}

impl Box<V> {
    pub fn put(V x) {
        self.v = x;
        self.vs.push(x);
    }

    pub fn get() -> V {
        return self.v;
    }

    pub fn at(int i) -> V {
        return self.vs[i];
    }
}

fn boxed(P x) -> Box<P> {
    let vs: Vec<P> = Vec::new();
    let c = new Box(x, vs);
    c.put(x);
    return c;
}

fn first(Vec<P> w) -> P {
    return w[0];
}

fn main() {
    let a: P = new P(1.5, 2.0);
    let b: P = new P(0.5, 4.0);
    println(say(first(boxed(a).vs)))?;
    println(say(first(boxed(b).vs)))?;
}
