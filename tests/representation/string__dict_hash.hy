// @output true\ntrue\n
//
// Representation matrix cell string x dict_hash: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(string v) -> string {
    return "str " + v;
}

fn hashed<W: Hash>(W w) -> int {
    return w.hash();
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(format("%v", hashed(a) == a.hash()))?;
    println(format("%v", hashed(b) == b.hash()))?;
}
