// @output held 4\ngone\n
//
// Representation matrix cell drop_enum x record_field: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
enum Res {
    Held(int),
    Gone,
}

impl Res {
    fn drop() {}
}

fn say(Res v) -> string {
    return match v {
        Res::Held(n) => format("held %i", n),
        Res::Gone => "gone",
    };
}

fn recorded(Res x) -> Res {
    let r = { v: x, n: 1 };
    return r.v;
}

fn main() {
    let a: Res = Res::Held(4);
    let b: Res = Res::Gone;
    println(say(recorded(a)))?;
    println(say(recorded(b)))?;
}
