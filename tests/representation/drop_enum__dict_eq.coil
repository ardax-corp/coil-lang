// @output true false\ntrue false\n
//
// Representation matrix cell drop_enum x dict_eq: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
enum Res {
    Held(int),
    Gone,
}

impl Res {
    fn drop() {}
}

fn say(Res v) -> string {
    return match v {
        Res::Held(n) => format("held %i", n),
        Res::Gone => "gone",
    };
}

fn same<W: Eq>(W a, W b) -> bool {
    return a == b;
}

fn main() {
    let a: Res = Res::Held(4);
    let b: Res = Res::Gone;
    println(format("%v %v", same(a, a), same(a, b)))?;
    println(format("%v %v", same(b, b), same(b, a)))?;
}
