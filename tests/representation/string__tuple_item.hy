// @output str one\nstr two\n
//
// Representation matrix cell string x tuple_item: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(string v) -> string {
    return "str " + v;
}

fn tupled<W>(W w) -> (W, int) {
    return (w, 1);
}

fn untupled(string x) -> string {
    let (y, _) = tupled(x);
    return y;
}

fn main() {
    let a: string = "one";
    let b: string = "two";
    println(say(untupled(a)))?;
    println(say(untupled(b)))?;
}
