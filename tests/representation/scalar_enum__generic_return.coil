// @output high\nlow\n
//
// Representation matrix cell scalar_enum x generic_return: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[repr(int)]
#[derive(Eq, Hash, Show)]
enum Lvl {
    Low = 1,
    High = 2,
}

fn say(Lvl v) -> string {
    return match v {
        Lvl::Low => "low",
        Lvl::High => "high",
    };
}

class Box<V> {
    pub v: V,
    pub vs: Vec<V>,
}

impl Box<V> {
    pub fn put(V x) {
        self.v = x;
        self.vs.push(x);
    }

    pub fn get() -> V {
        return self.v;
    }

    pub fn at(int i) -> V {
        return self.vs[i];
    }
}

fn boxed(Lvl x) -> Box<Lvl> {
    let vs: Vec<Lvl> = Vec::new();
    let c = new Box(x, vs);
    c.put(x);
    return c;
}

fn main() {
    let a: Lvl = Lvl::High;
    let b: Lvl = Lvl::Low;
    println(say(boxed(a).get()))?;
    println(say(boxed(b).get()))?;
}
