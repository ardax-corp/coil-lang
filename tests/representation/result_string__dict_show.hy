// @output true\ntrue\n
//
// Representation matrix cell result_string x dict_show: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<string, string> v) -> string {
    return match v {
        Ok(s) => "ok " + s,
        Err(e) => "err " + e,
    };
}

fn shown<W: Show>(W w) -> string {
    return w.show();
}

fn main() {
    let a: Result<string, string> = Ok("one");
    let b: Result<string, string> = Err("bad");
    println(format("%v", shown(a) == a.show()))?;
    println(format("%v", shown(b) == b.show()))?;
}
