// @output true\ntrue\n
//
// Representation matrix cell option_option x dict_show: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<Option<string>> v) -> string {
    return match v {
        Some(Some(s)) => "some some " + s,
        Some(None) => "some none",
        None => "none",
    };
}

fn shown<W: Show>(W w) -> string {
    return w.show();
}

fn main() {
    let a: Option<Option<string>> = Some(Some("one"));
    let b: Option<Option<string>> = Some(None);
    println(format("%v", shown(a) == a.show()))?;
    println(format("%v", shown(b) == b.show()))?;
}
