// @output int 7\nint -3\n
//
// Representation matrix cell int x tuple_item: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(int v) -> string {
    return format("int %i", v);
}

fn tupled<W>(W w) -> (W, int) {
    return (w, 1);
}

fn untupled(int x) -> int {
    let (y, _) = tupled(x);
    return y;
}

fn main() {
    let a: int = 7;
    let b: int = -3;
    println(say(untupled(a)))?;
    println(say(untupled(b)))?;
}
