// @output high\nlow\n
//
// Representation matrix cell scalar_enum x hashmap_get: generated by
// scripts/gen_rep_matrix.py, do not edit.
use collections::map::HashMap;
use io::sync::println;
use string::format;

#[repr(int)]
#[derive(Eq, Hash, Show)]
enum Lvl {
    Low = 1,
    High = 2,
}

fn say(Lvl v) -> string {
    return match v {
        Lvl::Low => "low",
        Lvl::High => "high",
    };
}

fn mapped(Lvl x) -> Lvl {
    let m: HashMap<string, Lvl> = HashMap::new();
    m.insert("k", x);
    return m.get_or("k", x);
}

fn main() {
    let a: Lvl = Lvl::High;
    let b: Lvl = Lvl::Low;
    println(say(mapped(a)))?;
    println(say(mapped(b)))?;
}
