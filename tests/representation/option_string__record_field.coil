// @output some one\nnone\n
//
// Representation matrix cell option_string x record_field: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<string> v) -> string {
    return match v {
        Some(s) => "some " + s,
        None => "none",
    };
}

fn recorded(Option<string> x) -> Option<string> {
    let r = { v: x, n: 1 };
    return r.v;
}

fn main() {
    let a: Option<string> = Some("one");
    let b: Option<string> = None;
    println(say(recorded(a)))?;
    println(say(recorded(b)))?;
}
