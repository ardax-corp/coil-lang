// @output ok one\nerr bad\n
//
// Representation matrix cell result_string x ground_arg: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<string, string> v) -> string {
    return match v {
        Ok(s) => "ok " + s,
        Err(e) => "err " + e,
    };
}

fn pass(Result<string, string> v) -> Result<string, string> {
    let w = v;
    return w;
}

fn main() {
    let a: Result<string, string> = Ok("one");
    let b: Result<string, string> = Err("bad");
    println(say(pass(a)))?;
    println(say(pass(b)))?;
}
