// @output ok one\nerr bad\n
//
// Representation matrix cell result_string x closure_capture: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Result<string, string> v) -> string {
    return match v {
        Ok(s) => "ok " + s,
        Err(e) => "err " + e,
    };
}

fn captured(Result<string, string> x) -> Result<string, string> {
    let f = fn () use (x) => x;
    return f();
}

fn main() {
    let a: Result<string, string> = Ok("one");
    let b: Result<string, string> = Err("bad");
    println(say(captured(a)))?;
    println(say(captured(b)))?;
}
