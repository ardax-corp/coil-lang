// @output high\nlow\n
//
// Representation matrix cell scalar_enum x host_pop: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[repr(int)]
#[derive(Eq, Hash, Show)]
enum Lvl {
    Low = 1,
    High = 2,
}

fn say(Lvl v) -> string {
    return match v {
        Lvl::Low => "low",
        Lvl::High => "high",
    };
}

fn popped(Lvl x) -> Lvl {
    let vs: Vec<Lvl> = [x];
    return match vs.pop() {
        Some(v) => v,
        None => panic "empty",
    };
}

fn main() {
    let a: Lvl = Lvl::High;
    let b: Lvl = Lvl::Low;
    println(say(popped(a)))?;
    println(say(popped(b)))?;
}
