// Representation matrix cell object x dict_show: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[derive(Eq, Hash, Show)]
class Obj {
    pub n: int,
}

fn say(Obj v) -> string {
    return format("obj %i", v.n);
}

fn shown<W: Show>(W w) -> string {
    return w.show();
}

fn main() {
    let a: Obj = new Obj(1);
    let b: Obj = new Obj(2);
    println(format("%v", shown(a) == a.show()))?;
    println(format("%v", shown(b) == b.show()))?;
}
