// @output some one\nnone\n
//
// Representation matrix cell option_string x host_pop: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

fn say(Option<string> v) -> string {
    return match v {
        Some(s) => "some " + s,
        None => "none",
    };
}

fn popped(Option<string> x) -> Option<string> {
    let vs: Vec<Option<string>> = [x];
    return match vs.pop() {
        Some(v) => v,
        None => panic "empty",
    };
}

fn main() {
    let a: Option<string> = Some("one");
    let b: Option<string> = None;
    println(say(popped(a)))?;
    println(say(popped(b)))?;
}
