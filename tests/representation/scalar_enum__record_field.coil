// @output high\nlow\n
//
// Representation matrix cell scalar_enum x record_field: generated by
// scripts/gen_rep_matrix.py, do not edit.
use io::sync::println;
use string::format;

#[repr(int)]
#[derive(Eq, Hash, Show)]
enum Lvl {
    Low = 1,
    High = 2,
}

fn say(Lvl v) -> string {
    return match v {
        Lvl::Low => "low",
        Lvl::High => "high",
    };
}

fn recorded(Lvl x) -> Lvl {
    let r = { v: x, n: 1 };
    return r.v;
}

fn main() {
    let a: Lvl = Lvl::High;
    let b: Lvl = Lvl::Low;
    println(say(recorded(a)))?;
    println(say(recorded(b)))?;
}
