// `==` / `!=` on arrays, `Vec`s and tuples compare their `float` elements
// by IEEE 754, as scalar `float` `==` does: `NaN != NaN`, `0.0 == -0.0`
// (#1253).
use tests::assert;

fn nan() -> float {
    let z = 0.0;
    return z / z;
}

test("NaN inside an array or tuple is not equal to itself") {
    let n = nan();
    assert!(!([n] == [n]));
    assert!([n] != [n]);
    assert!(!((n, 1) == (n, 1)));
    assert!(!([[1.0, n]] == [[1.0, n]]));
}

test("zero and negative zero are equal inside aggregates") {
    assert!([0.0] == [-0.0]);
    let v: Vec<float> = Vec::new();
    v.push(-0.0);
    let w: Vec<float> = Vec::new();
    w.push(0.0);
    assert!(v == w);
    assert!(!(v != w));
    assert!((1.0, "a", [0.0]) == (1.0, "a", [-0.0]));
}

test("aggregates without floats compare as before") {
    assert!([1, 2] == [1, 2]);
    assert!((1, "a") != (1, "b"));
    assert!([1.5, 2.5] == [1.5, 2.5]);
}

test("records and Vecs of tuples compare their floats by IEEE") {
    let n = nan();
    assert!({ x: 1.0, y: n } != { x: 1.0, y: n });
    assert!({ x: 0.0, y: 2.0 } == { x: -0.0, y: 2.0 });
    let v: Vec<(int, float)> = Vec::new();
    v.push((1, 0.0));
    let w: Vec<(int, float)> = Vec::new();
    w.push((1, -0.0));
    assert!(v == w);
    w.push((2, n));
    v.push((2, n));
    assert!(v != w);
}

fn same<T: Eq>(Vec<(T, float)> a, Vec<(T, float)> b) -> bool {
    return a == b;
}

test("a generic body compares its float leaves by IEEE") {
    let v: Vec<(string, float)> = Vec::new();
    v.push(("a", 0.0));
    let w: Vec<(string, float)> = Vec::new();
    w.push(("a", -0.0));
    assert!(same(v, w));
    v.push(("b", nan()));
    w.push(("b", nan()));
    assert!(!same(v, w));
}

test("a two-word (int, float) compares its float word by IEEE") {
    let n = nan();
    let t = (1, n);
    assert!(!(t == t));
    let v: Vec<(int, float)> = Vec::new();
    v.push((1, n));
    v.push((1, -0.0));
    assert!(!(v[0] == t));
    assert!(v[1] == (1, 0.0));
}
