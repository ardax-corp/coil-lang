// `x++` / `--x` on any place a compound assignment takes (#2661): an
// element of an element, an element of a field's element, a static's
// element, with indexes that are calls (each runs once), as a statement
// and as a value, as `x += 1` would.
use tests::assert;

class Row {
    pub cells: Vec<int>,
}

class Sheet {
    pub rows: Vec<Row>,
    pub grid: Vec<Vec<int>>,
}

static let G: Vec<Vec<int>> = Vec::new();

static let FLAT: Vec<int> = Vec::new();

static let CALLS: int = 0;

fn pick(int i) -> int {
    CALLS += 1;
    return i;
}

test("an element of an element") {
    let g: Vec<Vec<int>> = [[1, 2], [3, 4]];
    let r = 1;
    g[r][0]++;
    g[0][1]--;
    ++g[r][1];
    --g[0][0];
    assert!(g[0][0] == 0 && g[0][1] == 1 && g[1][0] == 4 && g[1][1] == 5);
    let old = g[r][0]++;
    let new = ++g[r][0];
    assert!(old == 4 && new == 6 && g[r][0] == 6);
    let f: Vec<Vec<float>> = [[1.5]];
    f[0][0]++;
    assert!(f[0][0] == 2.5);
}

test("indexes that are calls run once") {
    let g: Vec<Vec<int>> = [[1, 2], [3, 4]];
    CALLS = 0;
    g[pick(1)][pick(0)]++;
    let v = g[pick(1)][pick(1)]--;
    --g[pick(0)][pick(0)];
    assert!(CALLS == 6 && v == 4);
    assert!(g[0][0] == 0 && g[1][0] == 4 && g[1][1] == 3);
}

test("through fields and statics") {
    let rows: Vec<Row> = [new Row(Vec::from([1, 2]))];
    let grid: Vec<Vec<int>> = [[10, 20], [30, 40]];
    let s = new Sheet(rows, grid);
    s.rows[0].cells[1]++;
    let v = s.grid[1][0]++;
    CALLS = 0;
    s.grid[pick(1)][0]--;
    assert!(s.rows[0].cells[1] == 3 && v == 30 && s.grid[1][0] == 30 && CALLS == 1);
    G = Vec::from([Vec::from([5, 6])]);
    FLAT = Vec::from([7]);
    G[0][0]++;
    let w = ++G[0][1];
    FLAT[0]--;
    assert!(G[0][0] == 6 && w == 7 && G[0][1] == 7 && FLAT[0] == 6);
}

test("an element of a shared element is copied before it changes") {
    let g: Vec<Vec<int>> = [[1, 2]];
    let row = g[0];
    let whole = g;
    g[0][0]++;
    assert!(g[0][0] == 2 && row[0] == 1 && whole[0][0] == 1);
}
