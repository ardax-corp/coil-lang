// A range `for` whose body runs an inner `while` that breaks and then
// `continue`s: its step reads the counter the inner loop's blocks carry
// (#2856).
use tests::assert;

fn count() -> int {
    let s = 0;
    for i in 0..4 {
        let j = 0;
        while j < 3 {
            j = j + 1;
            if j == 2 {
                break;
            }
        }
        if i == 0 {
            continue;
        }
        s = s + j;
    }
    return s;
}

fn steps_inclusive() -> int {
    let s = 0;
    for i in 1..=3 {
        let j = 0;
        while true {
            j = j + 1;
            if j >= i {
                break;
            }
        }
        if j == 2 {
            continue;
        }
        s = s + j;
    }
    return s;
}

test("an inner while that breaks, then continue") {
    assert!(count() == 6);
}

test("an inclusive range with an inner loop and continue") {
    assert!(steps_inclusive() == 4);
}
