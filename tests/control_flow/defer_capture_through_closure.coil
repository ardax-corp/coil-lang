// A `defer use (mut p)` of a class parameter, with its function reached
// through a closure or a spawned task (#783).
use tests::assert;
use task::{scope, Scope};

class Log {
    pub n: int,
}

fn fails(Log log) -> int {
    defer use (mut log) {
        log.n = log.n + 1;
    }
    return 0;
}

fn call(unit -> int body) -> int {
    return body();
}

test("through a closure") {
    let log = new Log(0);
    let _ = call(fn () use (mut log) => fails(log));
    assert!(log.n == 1);
}

test("through a spawned task") {
    // The task writes a `Log` of its own and hands back what the defer did:
    // a `use (mut log)` closure the spawn keeps would borrow the outer `log`
    // past its scope (E0149, #2787).
    let r = scope(fn (Scope s) {
        let t = s.spawn(fn () {
            let log = new Log(0);
            let _ = fails(log);
            return log.n;
        });
        return match t.join() {
            Result::Ok(n) => n,
            Result::Err(_) => -1,
        };
    });
    assert!(r == Result::Ok(1));
}
