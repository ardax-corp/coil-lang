// A body with more than 64 `defer` homes (each capture of each `defer` is
// one): native code compiles it, and each home, heap words among them,
// survives a collection before the defers run (#2307).
use gc::collect;
use string::format;
use task::{scope, Scope, TaskError};
use tests::assert;

