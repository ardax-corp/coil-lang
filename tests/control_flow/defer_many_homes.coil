// Each defer allocates, then counts its home's length: the pads run with
// every heap home still rooted. (A `collect()` in a pad is coil-lang#2312.)
fn unwinds() -> int {
    let u0 = format("u%i", 0);
    defer use (u0) {
        let tag = format("%s!", u0);
        LOG = LOG + tag.len() - 1;
    }
    let u1 = format("u%i", 1);
    defer use (u1) {
        let tag = format("%s!", u1);
        LOG = LOG + tag.len() - 1;
    }
    let u2 = format("u%i", 2);
    defer use (u2) {
        let tag = format("%s!", u2);
        LOG = LOG + tag.len() - 1;
