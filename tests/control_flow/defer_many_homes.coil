fn failed(Result<int, TaskError> r) -> bool {
    return match r {
        Result::Ok(_) => false,
        Result::Err(_) => true,
    };
}

test("seventy string homes run in reverse") {
    let log: Vec<string> = [];
    many(log);
    assert!(log.len() == 70);
    assert!(log[0] == format("s%i", 69));
    assert!(log[69] == "s0");
}

test("seventy int homes and a result") {
    let log: Vec<int> = [];
    assert!(mixed(log) == 4830);
    assert!(log.len() == 70);
    assert!(log[0] == 138);
}

test("a panic runs seventy defers with their homes") {
    LOG = 0;
    let r = scope(fn (Scope s) {
        let _ = s.spawn(unwinds);
        0
    });
    assert!(failed(r));
    assert!(LOG == 200);
}
