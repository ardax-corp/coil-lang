// A ground trait instance's method takes a two-word argument in its own
// two words: an `Option<int>`, a `Result<int, string>`, an `(int, float)`
// parameter, and a two-field readonly class or payload enum as the
// instance's own type, from a direct call, a trait-qualified call, an
// operator, a `%v`, a bounded generic's dictionary and a lambda. A
// dictionary caller reaches the method through its `$dict` adapter, which
// takes the one boxed word and passes the pair.
use tests::assert;
use string::format;

trait Weigh<S> {
    fn weigh(S s, Option<int> o) -> int {}
    fn mixed(S s, (int, float) p, Result<int, string> r) -> string {}
}

readonly class P {
    pub a: int,
    pub b: int,
}

#[derive(Show, Eq, Hash)]
enum Cell {
    Num(int),
    Empty,
}

impl Weigh for int {
    #[inline(never)]
    pub fn weigh(int s, Option<int> o) -> int {
        return match o {
            Some(v) => s + v,
            None => s - 1,
        };
    }

    #[inline(never)]
    pub fn mixed(int s, (int, float) p, Result<int, string> r) -> string {
        let tail = match r {
            Ok(v) => format("ok %i", v),
            Err(e) => "err " + e,
        };
        return format("%i %i %v ", s, p[0], p[1]) + tail;
    }
}

impl Weigh for P {
    #[inline(never)]
    pub fn weigh(P s, Option<int> o) -> int {
        return s.a * 10 + s.b + (o ?? 100);
    }

    #[inline(never)]
    pub fn mixed(P s, (int, float) p, Result<int, string> r) -> string {
        return format("%i:%i %v", s.a, p[0], r.is_ok());
    }
}

impl Weigh for Cell {
    #[inline(never)]
    pub fn weigh(Cell s, Option<int> o) -> int {
        let base = match s {
            Cell::Num(n) => n,
            Cell::Empty => 0,
        };
        return base + (o ?? 0);
    }

    #[inline(never)]
    pub fn mixed(Cell s, (int, float) p, Result<int, string> r) -> string {
        return format("%v %v %v", s, p, r.is_err());
    }
}

impl Eq for P {
    #[inline(never)]
    pub fn eq(P x, P y) -> bool {
        return x.a == y.a && x.b == y.b;
    }
}

impl Show for P {
    #[inline(never)]
    pub fn show(P x) -> string {
        return format("P(%i, %i)", x.a, x.b);
    }
}

#[inline(never)]
fn weighed<W: Weigh>(W w, Option<int> o) -> int {
    return w.weigh(o);
}

#[inline(never)]
fn same<W: Eq>(W a, W b) -> bool {
    return a == b;
}

#[inline(never)]
fn shown<W: Show>(W w) -> string {
    return w.show();
}

fn twice(fn(int, Option<int>) -> int f, Option<int> o) -> int {
    return f(1, o) + f(2, o);
}

test("a direct call passes the pair") {
    let none: Option<int> = None;
    assert!(3.weigh(Some(4)) == 7);
    assert!(3.weigh(none) == 2);
    assert!(Weigh::weigh(5, Some(1)) == 6);
    assert!(new P(1, 2).weigh(Some(3)) == 15);
    assert!(new P(1, 2).weigh(none) == 112);
    assert!(Cell::Num(4).weigh(Some(1)) == 5);
    assert!(Cell::Empty.weigh(none) == 0);
    let ok: Result<int, string> = Ok(9);
    let err: Result<int, string> = Err("no");
    assert!(1.mixed((2, 0.5), ok) == "1 2 0.5 ok 9");
    assert!(1.mixed((2, 0.5), err) == "1 2 0.5 err no");
    assert!(new P(7, 8).mixed((2, 0.5), ok) == "7:2 true");
    assert!(Cell::Num(1).mixed((2, 0.5), err) == "Cell::Num(1) (2, 0.5) true");
}

test("an operator, a show and a loop") {
    let a = new P(1, 2);
    let b = new P(1, 3);
    assert!(a == a);
    assert!(a != b);
    assert!(a.show() == "P(1, 2)");
    assert!(format("%v", b) == "P(1, 3)");
    let total = 0;
    let i = 0;
    while i < 10 {
        let o: Option<int> = if i % 2 == 0 {
            Some(i)
        } else {
            None
        };
        total += i.weigh(o) + new P(i, 1).weigh(o);
        i += 1;
    }
    assert!(total == 1040);
}

test("a dictionary caller goes through the adapter") {
    let none: Option<int> = None;
    assert!(weighed(3, Some(4)) == 7);
    assert!(weighed(new P(1, 2), none) == 112);
    assert!(weighed(Cell::Num(2), Some(2)) == 4);
    assert!(same(new P(1, 2), new P(1, 2)));
    assert!(!same(new P(1, 2), new P(2, 2)));
    assert!(shown(new P(4, 5)) == "P(4, 5)");
}

test("a lambda over the method") {
    assert!(twice(fn (int s, Option<int> o) => s.weigh(o), Some(5)) == 13);
}
