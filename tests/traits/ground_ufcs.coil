// A trait method called trait-qualified on ground arguments goes straight
// to the instance's method, boxing the positions it unboxes.
use tests::assert;

trait Weigh<S> {
    fn weigh(S x, int k) -> int {}
}

class Crate {
    pub kg: int,
}

impl Weigh for int {
    pub fn weigh(int x, int k) -> int {
        return x * k;
    }
}

impl Weigh for Crate {
    pub fn weigh(Crate c, int k) -> int {
        return c.kg + k;
    }
}

fn heavy(Crate c) -> int {
    return Weigh::weigh(c, 1) + Weigh::weigh(3, 2);
}

test("ground trait-qualified trait calls") {
    assert!(Weigh::weigh(4, 5) == 20);
    assert!(heavy(new Crate(10)) == 17);
    assert!(Weigh::weigh(new Crate(2), Weigh::weigh(1, 3)) == 5);
    let n = 7;
    assert!(1 + Weigh::weigh(n, n) == 50);
}
