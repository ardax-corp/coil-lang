// A trait default body may compare two `T`s when the trait's parameter is
// bounded by `Ord`; only comparing a `T` with a concrete type is rejected
// (#838, see tests/compile_fail/type_param_rigid_trait_default.coil).
use tests::assert;

trait Pick<T: Ord> {
    fn larger(T a, T b) -> T {
        if a > b {
            return a;
        }
        return b;
    }

    fn tag(T x) -> int {}
}

impl Pick for int {
    pub fn tag(int x) -> int {
        return x;
    }
}

impl Pick for float {
    pub fn tag(float f) -> int {
        return 0;
    }
}

test("bounded default compares two T values") {
    assert!(3.larger(7) == 7);
    assert!(9.larger(2) == 9);
    assert!(0.larger(-5) == 0);
    assert!((1.5).larger(-2.5) == 1.5);
}
