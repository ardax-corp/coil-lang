// @expected E0107 — a `readonly` argument to a parameter the trait does not declare `readonly`, in the static spelling (#2845).
class Pt {
    pub a: int,
}

trait Tk<S> {
    fn take(S s, Pt p) -> int {}
}

impl Tk for int {
    fn take(int s, readonly Pt p) -> int {
        return s + p.a;
    }
}

fn main() {
    let p = readonly new Pt(8);
    let _ = Tk::take(1, p);
}
