// @expected E0153 — a static trait method is called on its owner (`int::make()`)
// or its trait (`Make::make()`); there is no bare spelling.
trait Make<T> {
    static fn make() -> T {}
}

impl Make for int {
    pub static fn make() -> int {
        return 1;
    }
}

fn main() {
    let x: int = make();
}
