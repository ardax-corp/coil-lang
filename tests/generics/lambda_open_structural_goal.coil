// A lambda in a bounded generic body meets a shape's goal over the body's
// type parameter with the dictionary it captures (coil-lang#2600):
// `(x, k).show()` under `U: Show` inside `fn (int k) use (x)` is the
// structural `Show<(_, int)>` with the enclosing frame's `Show<U>`, as the
// same expression in the body is. Also a nested lambda, `Eq` of a tuple and
// a trait method's own bound. `P`'s instances are not the structural ones,
// so a result built without them differs. The `clone-budget-0` cell runs
// every case on the shared bodies.
use tests::assert;

class P {
    pub v: int,
}

impl Show for P {
    fn show(P p) -> string {
        return "P" + p.v.show();
    }
}

impl Eq for P {
    fn eq(P a, P b) -> bool {
        return a.v / 10 == b.v / 10;
    }
}

fn shown_in_lambda<U: Show>(U x) -> string {
    let f = fn (int k) use (x) => (x, k).show();
    return f(1);
}

fn shown_in_nested<U: Show>(U x) -> string {
    let f = fn (int k) use (x) {
        let g = fn (int j) use (x, k) => Some((x, k + j)).show();
        return g(10);
    };
    return f(1);
}

fn same_in_lambda<U: Eq>(U x, U y) -> bool {
    let f = fn (int k) use (x, y) => (x, k) == (y, k);
    return f(2);
}

trait Label<S> {
    fn label<U: Show>(S s, U x) -> string {}
}

class Tag {
    pub name: string,
}

impl Label for Tag {
    fn label<U: Show>(Tag s, U x) -> string {
        let f = fn (int k) use (s, x) => s.name + (x, k).show();
        return f(7);
    }
}

test("a lambda shows a tuple over the body's type parameter") {
    assert!(shown_in_lambda(3) == "(3, 1)");
    assert!(shown_in_lambda(new P(4)) == "(P4, 1)");
    assert!(shown_in_lambda("s") == "(" + "s".show() + ", 1)");
}

test("a nested lambda shows an Option of a tuple over it") {
    assert!(shown_in_nested(3) == "Some((3, 11))");
    assert!(shown_in_nested(new P(5)) == "Some((P5, 11))");
}

test("a lambda compares tuples over the body's type parameter") {
    assert!(same_in_lambda(new P(31), new P(35)));
    assert!(!same_in_lambda(new P(31), new P(45)));
    assert!(same_in_lambda(3, 3) && !same_in_lambda(3, 4));
}

test("a lambda in a trait method with its own bound") {
    let t = new Tag("t");
    assert!(Label::label(t, 2) == "t(2, 7)");
    assert!(t.label(new P(6)) == "t(P6, 7)");
}
