// @expected E0102 — `g` is annotated `fn(int) -> Option<int>`, so it is the generic `wrap` at `int` and `g("x")` passes a `string` where it takes an `int` (#2760).
fn wrap<T>(T x) -> Option<T> {
    return Option::Some(x);
}

fn main() {
    let g: fn(int) -> Option<int> = wrap;
    let _ = g("x");
}
