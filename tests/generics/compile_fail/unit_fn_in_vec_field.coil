// @expected E0801 — a generic class's methods run their shared body, which
// reads a `T` the functions in its `Vec<fn() -> T>` field return as the word
// they return. A ground `-> ()` function returns the word `0`, not the empty
// tuple object a `()` is where it is stored, and no adapter reaches a
// function inside a `Vec` (#2541). Building the class at `T = ()` is
// refused, not given a wrong value.
class Many<T> {
    pub fs: Vec<fn() -> T>,
}

impl Many<T> {
    pub fn first() -> Option<T> {
        return Some(self.fs[0]());
    }
}

fn unit() -> () {}

fn main() {
    let fs: Vec<fn() -> ()> = [unit];
    let _ = new Many(fs).first() == Some(());
}
