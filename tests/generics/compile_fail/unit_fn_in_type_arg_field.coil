// @expected E0801 — a generic class's field holds a function returning its
// parameter as another class's type argument (`Holder<fn() -> T>`). Its
// shared methods read that function's `()` as the word it returns, `0` from
// a ground `-> ()` function, and `Holder`'s own field is a bare type
// parameter, which converts nothing (#2541). Building the class at `T = ()`
// is refused, not given a wrong value.
class Holder<U> {
    pub item: U,
}

class Outer<T> {
    pub h: Holder<fn() -> T>,
}

impl Outer<T> {
    pub fn run() -> Option<T> {
        let f = self.h.item;
        return Some(f());
    }
}

fn unit() -> () {}

fn main() {
    let _ = new Outer(new Holder(unit)).run() == Some(());
}
