// A generic class's methods at two-word type arguments (`(int, int)`,
// `Option<int>`, `Result<int, string>`, `(int, float)`) run as their own
// clones, which take and return the pair in two words.
use tests::assert;

class Acc<T> {
    pub items: Vec<T>,
}

impl Acc<T> {
    pub fn add(T x) {
        self.items.push(x);
    }

    pub fn at(int i) -> T {
        return self.items[i];
    }

    pub fn keep(T x) -> T {
        return x;
    }
}

test("tuple type argument") {
    let a: Acc<(int, int)> = new Acc(Vec::new());
    a.add((1, 2));
    a.add((3, 4));
    let (x, y) = a.at(1);
    assert!(x == 3 && y == 4);
    let (p, q) = a.keep((5, 6));
    assert!(p + q == 11);
}

test("option type argument") {
    let a: Acc<Option<int>> = new Acc(Vec::new());
    a.add(Some(7));
    a.add(None);
    assert!(a.at(0) == Some(7));
    assert!(a.at(1) == None);
    assert!(a.keep(Some(-1)) == Some(-1));
}

test("result type argument") {
    let a: Acc<Result<int, string>> = new Acc(Vec::new());
    a.add(Ok(1));
    a.add(Err("no"));
    let first = match a.at(0) {
        Ok(v) => v,
        Err(_) => 0,
    };
    let second = match a.keep(a.at(1)) {
        Ok(_) => "ok",
        Err(e) => e,
    };
    assert!(first == 1);
    assert!(second == "no");
}

test("mixed tuple type argument") {
    let a: Acc<(int, float)> = new Acc(Vec::new());
    a.add((2, 0.5));
    let (n, f) = a.keep(a.at(0));
    assert!(n == 2 && f == 0.5);
}
