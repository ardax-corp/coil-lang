// A generic class object built, written and returned in one body, its
// class parameter a boxed enum (`Option<Option<string>>`): the object's
// fields are kept in frame slots until it escapes, the `V` field as the
// enum's heap word (#2184).
use tests::assert;

class Box<V> {
    pub v: V,
    pub vs: Vec<V>,
}

fn boxed(Option<Option<string>> x) -> Box<Option<Option<string>>> {
    let vs: Vec<Option<Option<string>>> = Vec::new();
    let c = new Box(x, vs);
    c.v = x;
    c.vs.push(x);
    return c;
}

fn say(Option<Option<string>> v) -> string {
    return match v {
        Some(Some(s)) => "some " + s,
        Some(None) => "some none",
        None => "none",
    };
}

test("boxed enum class parameter in a scalar-replaced object") {
    let b = boxed(Some(Some("one")));
    assert!(b.vs.len() == 1, "pushed");
    assert!(say(b.v) == "some one", "field");
    assert!(say(b.vs[0]) == "some one", "element");
    let n = boxed(Some(None));
    assert!(say(n.v) == "some none", "inner none");
}
