// A call of a plain function value runs its body as a direct call does:
// captures and arguments arrive in order, heap captures survive
// collections in the body, a captured function value is called through, and a panic
// in the body still reaches the caller.
use tests::assert;
use gc::collect;
use string::format;
use thread::{join, spawn, ThreadError};

fn twice(int -> int f, int x) -> int {
    return f(f(x));
}

fn joined(int -> string f, int n) -> string {
    let s = "";
    let i = 0;
    while i < n {
        s = s + f(i);
        i = i + 1;
    }
    return s;
}

fn boom() -> int {
    let f = fn (int x) {
        10 / x
    };
    return f(0);
}

fn panics(() -> int f) -> bool {
    let t = match spawn(f) {
        Result::Ok(t) => t,
        Result::Err(_) => panic "spawn failed",
    };
    return match join(t) {
        Result::Err(ThreadError::Panicked(_)) => true,
        default => false,
    };
}

test("captures come before the arguments") {
    let a = 3;
    let b = 100;
    assert!(twice(fn (int x) use (a, b) {
        x * a + b
    }, 1) == (1 * 3 + 100) * 3 + 100);
}

test("a heap capture survives collections in the body") {
    let tag = format("t%i", 7);
    let s = joined(
        fn (int i) use (tag) {
            collect();
            format("%s:%i,", tag, i)
        },
        3,
    );
    assert!(s == "t7:0,t7:1,t7:2,");
}

test("a function value captured by another is called through") {
    let dec = fn (int m) {
        m - 1
    };
    assert!(twice(fn (int n) use (dec) {
        dec(dec(n))
    }, 10) == 6);
}

test("a panic in the body reaches the caller") {
    assert!(panics(boom));
}
