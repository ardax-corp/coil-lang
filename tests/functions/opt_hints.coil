// `#[inline]`, `#[inline(always)]`, `#[inline(never)]`, `#[cold]` and
// `#[hot]` change speed only: a tagged function, method or trait method
// returns what the untagged one would.
use tests::assert;

#[inline]
fn sq(int x) -> int {
    return x * x;
}

#[inline(always)]
fn cube(int x) -> int {
    return x * x * x;
}

#[inline(never)]
fn half(int x) -> int {
    return x / 2;
}

#[cold]
#[inline(never)]
fn rare(int x) -> int {
    return x - 1;
}

#[cold]
fn fail(string why) -> int {
    panic why;
}

#[hot]
fn sum<T>(Vec<T> xs, T -> int f) -> int {
    let total = 0;
    for x in xs {
        total = total + f(x);
    }
    return total;
}

#[inline]
#[hot]
fn twice(int x) -> int {
    return x + x;
}

#[inline]
fn fact(int n) -> int {
    if n <= 1 {
        return 1;
    }
    return n * fact(n - 1);
}

class Counter {
    pub n: int,
}

impl Counter {
    #[hot]
    pub fn bump(int by) {
        self.n = self.n + by;
    }

    #[cold]
    pub fn reset() {
        self.n = 0;
    }
}

trait Area<T> {
    fn area(T s) -> int {}
}

class Square {
    pub side: int,
}

impl Area for Square {
    #[inline]
    fn area(Square s) -> int {
        return s.side * s.side;
    }
}

test("tagged functions return what they compute") {
    assert!(sq(7) == 49);
    assert!(twice(21) == 42);
    assert!(fact(5) == 120);
    assert!(cube(3) == 27);
    assert!(half(9) == 4);
    assert!(rare(1) == 0);
    assert!(sum([1, 2, 3], sq) == 14);
    assert!(sum(["a", "bb"], fn (string s) => s.len()) == 3);
}

test("a cold function runs only when called") {
    let hit = 0;
    for i in 0..10 {
        if i == 9 {
            hit = hit + 1;
        } else if i > 9 {
            hit = fail("unreachable");
        }
    }
    assert!(hit == 1);
}

test("tagged methods and trait methods behave as untagged") {
    let c = new Counter(0);
    for i in 0..5 {
        c.bump(i);
    }
    assert!(c.n == 10);
    c.reset();
    assert!(c.n == 0);
    assert!(new Square(4).area() == 16);
}
