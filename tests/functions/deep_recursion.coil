// Deep recursion needs no attribute: the engine grows its stack whenever a
// frame opens without room. `black_box` keeps the
// calls here: with constant arguments they would run while compiling.
use tests::assert;

fn fib(int n) -> int {
    if n <= 2 {
        return 1;
    }
    return fib(n - 1) + fib(n - 2);
}

fn depth(int n) -> int {
    if n <= 0 {
        return 0;
    }
    return 1 + depth(n - 1);
}

fn ping(int n) -> int {
    if n <= 0 {
        return 0;
    }
    return pong(n - 1) + 1;
}

fn pong(int n) -> int {
    if n <= 0 {
        return 0;
    }
    return ping(n - 1) + 1;
}

enum Tree {
    Leaf,
    Node(int, Tree, Tree),
}

fn sum_tree(Tree t) -> int {
    return match t {
        Tree::Leaf => 0,
        Tree::Node(v, left, right) => v + sum_tree(left) + sum_tree(right),
    };
}

fn countdown(int n) -> int {
    if n <= 0 {
        return 0;
    }
    return 1 + countdown(n - 1);
}

test("dynamic entry") {
    assert!(fib(black_box(10)) == 55);
}

test("deeper than the initial stack") {
    assert!(depth(black_box(20000)) == 20000);
}

test("as deep as the frame limit allows") {
    assert!(depth(black_box(900000)) == 900000);
}

test("non-tail mutual recursion") {
    assert!(ping(black_box(10001)) == 10001);
}

test("recursive enum walk") {
    let t = Tree::Node(
        1,
        Tree::Node(2, Tree::Leaf(), Tree::Leaf()),
        Tree::Node(3, Tree::Leaf(), Tree::Leaf()),
    );
    assert!(sum_tree(t) == 6);
}

test("deep non-tail countdown") {
    assert!(countdown(black_box(5000)) == 5000);
}
