// @expected E0101 — `o.f(1)` is a method call: a class with a field `f` and no method `f` has nothing to call. The field's function is called as `(o.f)(1)` (#2472).
class Op {
    pub f: fn(int) -> int,
}

fn inc(int x) -> int {
    return x + 1;
}

fn main() {
    let o = new Op(inc);
    let _ = o.f(1);
}
