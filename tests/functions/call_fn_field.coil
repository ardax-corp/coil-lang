// `(o.f)(x)` calls the function a field holds (#2472): a parenthesized field
// read used as a callee is an indirect call of the field's value. `o.f(x)`
// is the method call it always was: with a method `f` it runs the method,
// with only a field `f` it is E0101 (compile_fail/call_fn_field_as_method).
use tests::assert;
use gc::collect;

class Op {
    pub f: fn(int) -> int,
}

readonly class Frozen {
    pub f: fn(int) -> int,
    pub k: int,
}

class Wide {
    pub half: fn(int) -> Option<int>,
    pub split: fn(int) -> (int, float),
    pub check: fn(int) -> Result<int, string>,
    pub name: fn(int) -> string,
    pub nothing: fn() -> (),
    pub seven: fn() -> int,
    pub add: fn(int, int) -> int,
    pub curry: fn(int) -> fn(int) -> int,
}

class Slot<T> {
    pub f: fn(T) -> T,
    pub v: T,
}

impl Slot<T> {
    pub fn run() -> T {
        return (self.f)(self.v);
    }

    pub fn run_on(T x) -> T {
        return (self.f)(x);
    }
}

class Inner {
    pub f: fn(int) -> int,
}

class Middle {
    pub b: Inner,
}

class Outer {
    pub a: Middle,
    pub fs: Vec<fn(int) -> int>,
}

// A field and a method of one name.
class Both {
    pub f: fn(int) -> int,
}

impl Both {
    pub fn f(int x) -> int {
        return x + 100;
    }

    pub fn through_self(int x) -> int {
        return (self.f)(x) * 1000 + self.f(x);
    }
}

fn inc(int x) -> int {
    return x + 1;
}

fn double(int x) -> int {
    return x * 2;
}

fn shout(string s) -> string {
    return s + "!";
}

fn half(int x) -> Option<int> {
    if x % 2 == 0 {
        return Some(x / 2);
    }
    return None;
}

fn split(int x) -> (int, float) {
    return (x, x as float / 2.0);
}

fn check(int x) -> Result<int, string> {
    if x < 0 {
        return Err("negative");
    }
    return Ok(x);
}

fn name(int x) -> string {
    return "n" + x.show();
}

fn nothing() {}

fn seven() -> int {
    return 7;
}

fn add(int a, int b) -> int {
    return a + b;
}

fn adder(int a) -> fn(int) -> int {
    return fn (int b) use (a) => a + b;
}

fn wide() -> Wide {
    return new Wide(half, split, check, name, nothing, seven, add, adder);
}

fn run_slot<T>(Slot<T> s, T x) -> T {
    return (s.f)(x);
}

fn make_adder(int n) -> Op {
    return new Op(fn (int x) use (n) => x + n);
}

test("the issue's program") {
    let o = new Op(inc);
    assert!((o.f)(1) == 2);
    let g = o.f;
    assert!(g(1) == (o.f)(1));
}

test("a readonly class and a readonly value") {
    let z = new Frozen(double, 3);
    assert!((z.f)(z.k) == 6);
    let r = readonly new Op(inc);
    assert!((r.f)(41) == 42);
}

test("a two-word result") {
    let w = wide();
    assert!((w.half)(8) == Some(4));
    assert!((w.half)(7) == None);
    let (n, h) = (w.split)(5);
    assert!(n == 5);
    assert!(h == 2.5);
    assert!((w.check)(3) == Ok(3));
    assert!((w.check)(-1) == Err("negative"));
    let got = match (w.half)(10) {
        Some(v) => v,
        None => -1,
    };
    assert!(got == 5);
}

test("other argument and result shapes") {
    let w = wide();
    assert!((w.name)(4) == "n4");
    (w.nothing)();
    assert!((w.seven)() == 7);
    assert!((w.add)(2, 3) == 5);
    assert!((w.curry)(2)(3) == 5);
    let plus2 = (w.curry)(2);
    assert!(plus2(40) == 42);
}

test("a field holding a closure with captures") {
    let base = 10;
    let label = "k";
    let o = new Op(fn (int x) use (base, label) => x + base + label.len());
    assert!((o.f)(1) == 12);
    let made = make_adder(5);
    collect();
    assert!((made.f)(1) == 6);
    let ops: Vec<Op> = Vec::new();
    for i in 0..4 {
        ops.push(make_adder(i));
    }
    collect();
    let total = 0;
    for op in ops {
        total = total + (op.f)(10);
    }
    assert!(total == 46);
}

test("a generic class") {
    let a = new Slot(inc, 1);
    assert!((a.f)(a.v) == 2);
    assert!(a.run() == 2);
    assert!(a.run_on(9) == 10);
    let s = new Slot(shout, "hi");
    assert!((s.f)("yo") == "yo!");
    assert!(s.run() == "hi!");
    assert!(run_slot(a, 4) == 5);
    assert!(run_slot(s, "go") == "go!");
    let p = new Slot(fn (float x) => x * 2.0, 1.5);
    assert!(p.run() == 3.0);
    assert!(run_slot(p, 0.25) == 0.5);
}

test("a call through a chain") {
    let o = new Outer(new Middle(new Inner(double)), [inc, double]);
    assert!((o.a.b.f)(21) == 42);
    assert!(((o.a).b.f)(4) == 8);
    assert!((o.fs[0])(1) == 2);
    assert!((o.fs[1])(4) == 8);
}

test("a field and a method of one name") {
    let b = new Both(inc);
    // The method.
    assert!(b.f(1) == 101);
    // The field's function.
    assert!((b.f)(1) == 2);
    assert!(((b.f))(1) == 2);
    assert!(b.through_self(1) == 2101);
}

test("as a statement, an argument and an operand") {
    let o = new Op(inc);
    (o.f)(0);
    assert!(double((o.f)(1)) == 4);
    assert!((o.f)((o.f)(1)) == 3);
    assert!((o.f)(1) + (o.f)(2) == 5);
    let xs = [(o.f)(1), (o.f)(2)];
    assert!(xs[0] + xs[1] == 5);
}

test("the field is read when the call runs") {
    let o = new Op(inc);
    assert!((o.f)(5) == 6);
    o.f = double;
    assert!((o.f)(5) == 10);
}
