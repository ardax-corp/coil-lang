// ffi_sum.coil — the smallest `extern` block: one C function from a shared
// library, called like a Coil function.
//
// The corresponding C source is `sum.c` in this directory:
//
//   int64_t sum(int64_t a, int64_t b) { return a + b; }
//
// Build the shared library (from repo root):
//
//   Linux:  cc -shared -fPIC -o examples/libsum.so examples/sum.c
//   macOS:  cc -dynamiclib -o examples/libsum.dylib examples/sum.c
//   Windows: clang -shared -o examples/sum.dll examples/sum.c
//
// `extern "sum"` resolves to the platform filename via
// `--ffi-search-path examples`. Every stem needs `--allow-dload STEM` plus
// `--dload-pin STEM=SHA256` or `--dload-trusted STEM` — including `time` / `crypto` / `tls` /
// `regex`. `extern "c"` is always denied; an absolute path is not a bypass.
// To load a library chosen while the program runs, use the coil-ffi package.
//
// @output (not checked: needs `--allow-dload sum`; see the example_ffi_* pipeline tests)

use io::sync::print;
use string::format;

extern "sum" {
    fn sum(int a, int b) -> int;
}

fn main() {
    let _ = print(format("%i", sum(40, 2)));
}
