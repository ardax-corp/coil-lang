// C calls back into coil through a function-typed `extern` parameter.
// Expected output: `42`.
//
// @output (not checked: needs `--allow-dload sum`; see the example_ffi_* pipeline tests)

use io::sync::print;
use string::format;

extern "sum" {
    fn apply_cb(fn(int x) -> int cb, int x) -> int;
}

fn doubler(int x) -> int {
    return x * 2;
}

fn main() {
    let _ = print(format("%i", apply_cb(doubler, 21)));
}
