// Mono clones of generic functions at two-word types: a bare `T` at
// `Option<int>` and an open tuple `(T, T)` at `(int, int)` go as their two
// words in and out of the clone, no `Option` or tuple boxed per call.
use io::sync::print;
use string::format;

#[inline(never)]
fn pick<T>(bool c, T a, T b) -> T {
    if c {
        return a;
    }
    return b;
}

#[inline(never)]
fn swap<T>((T, T) p) -> (T, T) {
    return (p[1], p[0]);
}

fn main() {
    let s = 0;
    let i = 0;
    while i < 10000000 {
        let o: Option<int> = pick(i % 3 == 0, None, Some(i / 2));
        s += match o {
            Some(v) => v,
            None => 1,
        };
        let p = swap((i, s & 7));
        s += p[0] + (p[1] & 1);
        i += 1;
    }
    let _ = print(format("%i\n", s));
}
