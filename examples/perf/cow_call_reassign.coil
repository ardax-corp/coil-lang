// CPU: copy-on-write across `v = f(v)` (#2206). The callee pushes into
// the vector it is given and returns it; the caller assigns the result
// back, so the old value is dead and no copy is needed.
use io::sync::print;
use string::format;

fn add(Vec<int> vs, int x) -> Vec<int> {
    vs.push(x);
    return vs;
}

fn main() {
    let vs: Vec<int> = Vec::new();
    let i = 0;
    while i < 20000 {
        vs = add(vs, i);
        i = i + 1;
    }
    let _ = print(format("%i\n", vs.len()));
}
