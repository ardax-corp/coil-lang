// CPU: a class field of a tuple of a string and numbers nested in it,
// (string, (int, int)), read and written in a loop. Its three leaves are
// slots of the object, the string's a pointer slot, so a write stores
// three words and a read loads them: no tuple object made per write, none
// followed per read.
use io::sync::print;
use string::format;

class Tagged {
    pub tag: (string, (int, int)),
    pub hits: int,
}

#[inline(never)]
fn step(Tagged t, string other, int i) {
    let e = t.tag;
    let name = if (e[1][0] & 1) == 0 {
        e[0]
    } else {
        other
    };
    t.tag = (name, (e[1][1] & 1023, (e[1][0] + i + name.len()) & 1023));
    t.hits += 1;
}

fn main() {
    let t = new Tagged(("even", (1, 2)), 0);
    let i = 0;
    while i < 10000000 {
        step(t, "odd", i);
        i += 1;
    }
    let _ = print(format("%v %i %i %i\n", t.tag[0], t.tag[1][0], t.tag[1][1], t.hits));
}
