// CPU: nested tuples, ((int, int), int) and (((int, int), int), int),
// through direct calls: flattened to their three and four leaf words in
// registers, no tuple built per call at any depth.
use io::sync::print;
use string::format;

#[inline(never)]
fn mk(int a) -> ((int, int), int) {
    return ((a & 255, a & 15), 3);
}

#[inline(never)]
fn weigh(((int, int), int) t) -> int {
    return t[0][0] + t[0][1] * 3 + t[1];
}

#[inline(never)]
fn deep(int a) -> (((int, int), int), int) {
    return (((a & 7, 1), 2), a & 63);
}

#[inline(never)]
fn wdeep((((int, int), int), int) t) -> int {
    return t[0][0][0] + t[0][0][1] + t[0][1] * 5 + t[1];
}

fn main() {
    let s = 0;
    let i = 0;
    while i < 10000000 {
        s += weigh(mk(i));
        s += wdeep(deep(i));
        s = s & 0xffffff;
        i += 1;
    }
    let _ = print(format("%i\n", s));
}
