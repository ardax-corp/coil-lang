// Integer-payload Option: helper RETURNS two-slot Option<int>
// (two-slot return). No ObjEnum.
// Heap-payload
// counterpart: examples/perf/gc_churn.coil.
// ITERS=20000000 (period-10 checksum 42 * 2e6); release ~1-3s.
use io::sync::print;
use string::format;

fn lookup(int i, int n) -> Option<int> {
    if i < 0 || i >= n {
        return Option::None;
    }
    return Option::Some(i * 2);
}

fn main() {
    let n = 7;
    let iters = 20000000;
    let acc = 0;
    let i = 0;
    while i < iters {
        acc = acc + match lookup(i % 10, n) {
            Option::Some(x) => x,
            Option::None => 0,
        };
        i = i + 1;
    }
    let _ = print(format("%i", acc));
}
