// CPU: a Result<(int, int, int), string> a direct call takes: a call's
// result, an Ok of a fresh tuple. Its words, the Err payload in a word it
// shares and the Ok flag go in registers, no tuple built per call.
use io::sync::print;
use string::format;

#[inline(never)]
fn get(int a, string bad) -> Result<(int, int, int), string> {
    if a % 7 == 0 {
        return Err(bad);
    }
    return Ok((a & 255, a & 15, 7));
}

#[inline(never)]
fn total(Result<(int, int, int), string> r) -> int {
    return match r {
        Ok(t) => t[0] + t[1] * 2 + t[2],
        Err(e) => e.len(),
    };
}

fn main() {
    let bad = "bad";
    let s = 0;
    let i = 0;
    while i < 10000000 {
        s += total(get(i, bad));
        s += total(Ok((i & 31, 1, 2)));
        s = s & 0xffffff;
        i += 1;
    }
    let _ = print(format("%i\n", s));
}
