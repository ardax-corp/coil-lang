// CPU: force sibling TailCall (even↔odd cycle). Tree recursion is not this shape.
// The calls are in tail position, so each takes its caller's frame.
use io::sync::print;
use string::format;

fn even(int n, int acc) -> int {
    if n == 0 {
        return acc;
    }
    return odd(n - 1, acc + n);
}

fn odd(int n, int acc) -> int {
    if n == 0 {
        return acc;
    }
    return even(n - 1, acc + n);
}

fn main() {
    let s = 0;
    let i = 0;
    while i < 62500 {
        s = s + even(80, 0);
        i = i + 1;
    }
    let _ = print(format("%i", s));
}
