// CPU: `get_or` on a `HashMap<string, int>` of 5000 keys, looked up with
// strings equal to the keys but built apart from them (other objects), n
// times. `n` is the last argument (default 1000000).
use collections::map::HashMap;
use conv::parse_int;
use env::args;
use io::sync::print;
use string::format;

fn arg_n(int fallback) -> int {
    let argv = match args() {
        Result::Ok(a) => a,
        Result::Err(_) => Vec::new(),
    };
    if argv.len() < 2 {
        return fallback;
    }
    return match parse_int(argv[argv.len() - 1]) {
        Result::Ok(n) => n,
        Result::Err(_) => fallback,
    };
}

fn main() {
    let n = arg_n(1000000);
    let m: HashMap<string, int> = HashMap::new();
    let probes: Vec<string> = Vec::new();
    let i = 0;
    while i < 5000 {
        m.insert(format("key-%i", i), i);
        probes.push(format("key-%i", (i * 37) % 5000));
        i += 1;
    }
    let total = 0;
    i = 0;
    while i < n {
        total += m.get_or(probes[i % 5000], 0);
        i += 1;
    }
    let _ = print(format("%i\n", total));
}
