// CPU: a ground trait instance method and an inherent method taking an
// (int, int, int): three words in registers, no tuple built per call.
use io::sync::print;
use string::format;

trait Weigh<S> {
    fn weigh(S s, (int, int, int) t) -> int {}
}

impl Weigh for int {
    #[inline(never)]
    pub fn weigh(int s, (int, int, int) t) -> int {
        return s + t[0] * 3 + t[1] - t[2];
    }
}

class Acc {
    pub n: int,
}

impl Acc {
    #[inline(never)]
    pub fn add((int, int, int) t) -> int {
        self.n = (self.n + t[0] + t[1] * t[2]) & 0xffff;
        return self.n;
    }
}

fn main() {
    let s = 0;
    let acc = new Acc(0);
    let i = 0;
    while i < 10000000 {
        s += (i & 7).weigh((i, s & 15, 2));
        s += acc.add((i & 3, s & 7, 4));
        s = s & 0xffffff;
        i += 1;
    }
    let _ = print(format("%i\n", s));
}
