// Hit bench (ProductLoad): the fields of 4k six-field instances (their
// fields spill past the inline four) read 500 rounds (each its own call).
use io::sync::print;
use string::format;

class Wide {
    pub a: int,
    pub b: int,
    pub c: int,
    pub d: int,
    pub e: int,
    pub f: int,
}

fn build(int n) -> Vec<Wide> {
    let out: Vec<Wide> = Vec::with_capacity(n);
    let i = 0;
    while i < n {
        out.push(new Wide(i, i % 3, i % 5, i % 7, i % 11, i % 13));
        i = i + 1;
    }
    return out;
}

fn sum(Vec<Wide> items, int k) -> int {
    let total = k;
    let i = 0;
    while i < items.len() {
        let w = items[i];
        total = total + w.a + w.b + w.c + w.d + w.e * w.f;
        i = i + 1;
    }
    return total;
}

fn main() {
    let items = build(4000);
    let total = 0;
    let round = 0;
    while round < 500 {
        total = total + sum(items, round);
        round = round + 1;
    }
    let _ = print(format("%i", total));
}
