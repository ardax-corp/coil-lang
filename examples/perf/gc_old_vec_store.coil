// GC write barrier on a store loop (#2687): a large `Vec<int>` that is old
// (it outlives many minor collections) is stored into in a loop that also
// allocates, so minors keep running and the vector is written after each.
// The big vector's stores are ints: what this measures is the in-place
// store path and what each minor pays for the written vector. The cells go
// to a small ring so they escape and fill the nursery.
use io::sync::print;
use string::format;

class Cell {
    pub v: int,
}

fn main() {
    let n = 1000000;
    let v: Vec<int> = Vec::with_capacity(n);
    let i = 0;
    while i < n {
        v.push(i);
        i = i + 1;
    }
    let ring: Vec<Cell> = Vec::new();
    i = 0;
    while i < 16 {
        ring.push(new Cell(i));
        i = i + 1;
    }
    let s = 0;
    i = 0;
    while i < 20000000 {
        let c = new Cell(i);
        ring[i % 16] = c;
        v[(i * 7) % n] = c.v;
        i = i + 1;
    }
    i = 0;
    while i < 16 {
        s = s + ring[i].v;
        i = i + 1;
    }
    i = 0;
    while i < n {
        s = s + v[i];
        i = i + 1;
    }
    let _ = print(format("%i", s));
}
