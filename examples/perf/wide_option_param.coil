// CPU: an Option<(int, int, int)> a direct call takes: a call's result, a
// Some of a fresh tuple, a None. Its words and the Some flag go in
// registers, no tuple built per call.
use io::sync::print;
use string::format;

#[inline(never)]
fn find(int a) -> Option<(int, int, int)> {
    if a % 3 == 0 {
        return None;
    }
    return Some((a & 255, a & 15, 7));
}

#[inline(never)]
fn total(Option<(int, int, int)> o) -> int {
    return match o {
        Some(t) => t[0] + t[1] * 2 + t[2],
        None => 1,
    };
}

fn main() {
    let s = 0;
    let i = 0;
    while i < 10000000 {
        s += total(find(i));
        s += total(Some((i & 31, 1, 2)));
        s = s & 0xffffff;
        i += 1;
    }
    let _ = print(format("%i\n", s));
}
