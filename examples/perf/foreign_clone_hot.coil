// Small methods of another module's generic class in a hot loop: their
// per-type clones are spliced into `main` (cross-module inlining), so the
// loop makes no calls.
use xm_bag::bag;
use string::{format, to_bytes};
use io::{stdout, write};

fn main() {
    let items: Vec<int> = Vec::new();
    for i in 0..1000 {
        items.push(i * 2);
    }
    let b = bag(items);
    let t = 0;
    for r in 0..300 {
        for j in 0..1000 {
            t = t + b.at_or(j, 0) + b.len();
            if b.has(j + r) {
                t = t + 1;
            }
        }
    }
    let _ = write(stdout(), to_bytes(format("%i\n", t)));
}
