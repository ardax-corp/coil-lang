// CPU: a Vec of three-word tuples, filled then summed.
use io::sync::print;
use string::format;

fn main() {
    let v: Vec<(int, int, int)> = Vec::new();
    let i = 0;
    while i < 2000000 {
        v.push((i, i + 1, i + 2));
        i += 1;
    }
    let s = 0;
    for r in 0..5 {
        for t in v {
            let (a, b, c) = t;
            s += a + b + c + r;
        }
    }
    let _ = print(format("%i\n", s));
}
