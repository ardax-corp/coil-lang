// Hit bench (opt hints step 5): `#[hot]` on a function over the default
// inline cost limit but under the hot limit (400), called in a loop.
// Without the tag the call stays.
use io::sync::print;

#[hot]
fn mix(int x, int y) -> int {
    let v0 = (x * 31 + y) % 1000003;
    let v1 = (v0 ^ 1) % 1000003;
    let v2 = (v1 ^ 2) % 1000003;
    let v3 = (v2 ^ 3) % 1000003;
    let v4 = (v3 ^ 4) % 1000003;
    let v5 = (v4 ^ 5) % 1000003;
    let v6 = (v5 ^ 6) % 1000003;
    let v7 = (v6 ^ 7) % 1000003;
    let v8 = (v7 ^ 8) % 1000003;
    let v9 = (v8 ^ 9) % 1000003;
    let v10 = (v9 ^ 10) % 1000003;
    let v11 = (v10 ^ 11) % 1000003;
    let v12 = (v11 ^ 12) % 1000003;
    let v13 = (v12 ^ 13) % 1000003;
    let v14 = (v13 ^ 14) % 1000003;
    let v15 = (v14 ^ 15) % 1000003;
    let v16 = (v15 ^ 16) % 1000003;
    let v17 = (v16 ^ 17) % 1000003;
    let v18 = (v17 ^ 18) % 1000003;
    let v19 = (v18 ^ 19) % 1000003;
    let v20 = (v19 ^ 20) % 1000003;
    let v21 = (v20 ^ 21) % 1000003;
    let v22 = (v21 ^ 22) % 1000003;
    let v23 = (v22 ^ 23) % 1000003;
    let v24 = (v23 ^ 24) % 1000003;
    let v25 = (v24 ^ 25) % 1000003;
    let v26 = (v25 ^ 26) % 1000003;
    let v27 = (v26 ^ 27) % 1000003;
    let v28 = (v27 ^ 28) % 1000003;
    let v29 = (v28 ^ 29) % 1000003;
    let v30 = (v29 ^ 30) % 1000003;
    let v31 = (v30 ^ 31) % 1000003;
    let v32 = (v31 ^ 32) % 1000003;
    let v33 = (v32 ^ 33) % 1000003;
    let v34 = (v33 ^ 34) % 1000003;
    let v35 = (v34 ^ 35) % 1000003;
    let v36 = (v35 ^ 36) % 1000003;
    let v37 = (v36 ^ 37) % 1000003;
    let v38 = (v37 ^ 38) % 1000003;
    let v39 = (v38 ^ 39) % 1000003;
    let v40 = (v39 ^ 40) % 1000003;
    let v41 = (v40 ^ 41) % 1000003;
    let v42 = (v41 ^ 42) % 1000003;
    let v43 = (v42 ^ 43) % 1000003;
    let v44 = (v43 ^ 44) % 1000003;
    let v45 = (v44 ^ 45) % 1000003;
    let v46 = (v45 ^ 46) % 1000003;
    let v47 = (v46 ^ 47) % 1000003;
    let v48 = (v47 ^ 48) % 1000003;
    let v49 = (v48 ^ 49) % 1000003;
    let v50 = (v49 ^ 50) % 1000003;
    let v51 = (v50 ^ 51) % 1000003;
    let v52 = (v51 ^ 52) % 1000003;
    let v53 = (v52 ^ 53) % 1000003;
    let v54 = (v53 ^ 54) % 1000003;
    let v55 = (v54 ^ 55) % 1000003;
    let v56 = (v55 ^ 56) % 1000003;
    let v57 = (v56 ^ 57) % 1000003;
    let v58 = (v57 ^ 58) % 1000003;
    let v59 = (v58 ^ 59) % 1000003;
    return v59;
}

fn main() {
    let acc = 0;
    let i = 0;
    while i < 300000 {
        acc = mix(acc, i);
        i = i + 1;
    }
    let _ = print(acc.show());
}
