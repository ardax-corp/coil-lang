// Reuse in place: a persistent search tree. Each insert rebuilds the path
// to the new key, and the old path's nodes die as the new ones are built.
use io::sync::println;
use string::format;

enum Tree {
    Leaf,
    Node(Tree, int, Tree),
}

fn insert(Tree t, int k) -> Tree {
    return match t {
        Tree::Leaf => Tree::Node(Tree::Leaf(), k, Tree::Leaf()),
        Tree::Node(l, v, r) => if k < v {
            Tree::Node(insert(l, k), v, r)
        } else if k > v {
            Tree::Node(l, v, insert(r, k))
        } else {
            Tree::Node(l, v, r)
        },
    };
}

fn size(Tree t) -> int {
    return match t {
        Tree::Leaf => 0,
        Tree::Node(l, _, r) => size(l) + 1 + size(r),
    };
}

fn main() {
    let t = Tree::Leaf();
    let i = 0;
    let x = 12345;
    while i < 200000 {
        x = (x * 1103515245 + 12345) % 2147483648;
        t = insert(t, x % 100000);
        i += 1;
    }
    let _ = println(format("%i", size(t)));
}
