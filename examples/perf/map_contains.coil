// CPU: `contains` on a `HashMap<int, int>` of 10000 keys, n lookups, half
// of them misses. `n` is the last argument (default 2000000).
use collections::map::HashMap;
use conv::parse_int;
use env::args;
use io::sync::print;
use string::format;

fn arg_n(int fallback) -> int {
    let argv = match args() {
        Result::Ok(a) => a,
        Result::Err(_) => Vec::new(),
    };
    if argv.len() < 2 {
        return fallback;
    }
    return match parse_int(argv[argv.len() - 1]) {
        Result::Ok(n) => n,
        Result::Err(_) => fallback,
    };
}

fn main() {
    let n = arg_n(2000000);
    let m: HashMap<int, int> = HashMap::new();
    let i = 0;
    while i < 10000 {
        m.insert(i * 2, i);
        i += 1;
    }
    let hit = 0;
    i = 0;
    while i < n {
        if m.contains(i % 20000) {
            hit += 1;
        }
        i += 1;
    }
    let _ = print(format("%i\n", hit));
}
