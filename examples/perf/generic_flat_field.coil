// CPU: a generic class's field at a two-word argument, written in a loop.
use io::sync::print;
use string::format;

class Cell<V> {
    pub v: V,
}

fn main() {
    let c: Cell<Option<int>> = new Cell(None);
    let s = 0;
    let i = 0;
    while i < 20000000 {
        c.v = if i % 3 == 0 {
            None
        } else {
            Some(i)
        };
        s += match c.v {
            Some(x) => x,
            None => 1,
        };
        i += 1;
    }
    let _ = print(format("%i\n", s));
}
