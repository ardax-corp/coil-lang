// Splitting a long line into many short words: a byte scan and a
// slice per piece. Prints the piece count.
use io::sync::println;
use string::format;
use text::Searchable;

fn main() {
    let s = "";
    let i = 0;
    while i < 20000 {
        s = s + format("w%i ", i % 97);
        i = i + 1;
    }
    let total = 0;
    let r = 0;
    while r < 20 {
        let parts = s.split(" ");
        total = total + parts.len();
        r = r + 1;
    }
    let _ = println(format("%i", total));
}
