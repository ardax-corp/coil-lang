// Hit bench for COI-287 W1: dense lowering of float +/− (no * or /).
// Add-only loops must take the dense path too. DIVF already
// qualified — this kernel must not use * or / or parent and W1 match.
use io::sync::print;
use string::format;

fn hot(float a, float b, int n) -> float {
    let i = 0;
    let s = 0.0;
    while i < n {
        let xf = i as float;
        s = s + xf + a - b;
        i = i + 1;
    }
    return s;
}

fn main() {
    let _ = print(format("%i", hot(2.0, 1.0, 2000000) as int));
}
