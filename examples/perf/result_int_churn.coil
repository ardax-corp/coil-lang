// Integer-payload Result: helper RETURNS two-slot Result<int, int>
// (two-slot return). No ObjEnum.
// Heap-payload
// counterpart: examples/perf/result_heap_churn.coil.
// ITERS=20000000 (period-10 checksum 19 * 2e6); release ~1-3s.
use io::sync::print;
use string::format;

fn checked_div(int a, int b) -> Result<int, int> {
    if b == 0 {
        return Result::Err(-1);
    }
    return Result::Ok(a / b);
}

fn main() {
    let iters = 20000000;
    let acc = 0;
    let i = 0;
    while i < iters {
        acc = acc + match checked_div((i % 10) + 1, i % 5) {
            Result::Ok(q) => q,
            Result::Err(e) => e,
        };
        i = i + 1;
    }
    let _ = print(format("%i", acc));
}
