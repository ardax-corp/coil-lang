// Reuse in place where nothing can be reused: every node of the input is
// shared (a tree of depth 20 built as a chain of twin subtrees), so each
// match's object lives on and its decrement is the shared one.
use io::sync::println;
use string::format;

enum Tree {
    Leaf(int),
    Node(Tree, Tree),
}

fn twins(int depth) -> Tree {
    if depth == 0 {
        return Tree::Leaf(1);
    }
    let sub = twins(depth - 1);
    return Tree::Node(sub, sub);
}

fn mirror(Tree t) -> Tree {
    return match t {
        Tree::Leaf(v) => Tree::Leaf(v),
        Tree::Node(l, r) => Tree::Node(mirror(r), mirror(l)),
    };
}

fn count(Tree t) -> int {
    return match t {
        Tree::Leaf(v) => v,
        Tree::Node(l, r) => count(l) + count(r),
    };
}

fn main() {
    let dag = twins(18);
    let total = 0;
    let pass = 0;
    while pass < 8 {
        total += count(mirror(dag));
        pass += 1;
    }
    let _ = println(format("%i", total));
}
