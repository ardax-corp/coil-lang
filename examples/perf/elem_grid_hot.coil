// CPU: a nested element update, `g[i][j] = g[i][j] + j`, over a 1000 by
// 1000 grid, five times. The row's copy-on-write check does not change in
// the inner loop, so it can run once per row, not once per cell.
use io::sync::println;
use string::format;

fn main() {
    let n = 1000;
    let g: Vec<Vec<int>> = Vec::new();
    let i = 0;
    while i < n {
        let row: Vec<int> = Vec::new();
        let j = 0;
        while j < n {
            row.push(0);
            j = j + 1;
        }
        g.push(row);
        i = i + 1;
    }
    let r = 0;
    while r < 5 {
        i = 0;
        while i < n {
            let j = 0;
            while j < n {
                g[i][j] = g[i][j] + j;
                j = j + 1;
            }
            i = i + 1;
        }
        r = r + 1;
    }
    let _ = println(format("rows=%i cell=%i", g.len(), g[7][9]));
}
