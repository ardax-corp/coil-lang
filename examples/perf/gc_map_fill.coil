// GC pacing (#2350): fill a stdlib `HashMap` with class instances, then read
// them back. The map's value vector is a generic body's `Vec<V>`, so a minor
// collection finds every young `Node` through an ambiguous word and pins it:
// each nursery's chunks are held until a major cycle. The live set only
// grows, so a major that keeps every held chunk must not ask for the next
// one at once. Needs the stdlib root (`--root .deps/coil-stdlib/src`).
use io::sync::print;
use string::format;
use collections::map::HashMap;

class Node {
    pub v: int,
}

fn main() {
    let n = 300000;
    let m: HashMap<int, Node> = HashMap::new();
    let i = 0;
    while i < n {
        m.insert(i, new Node(i));
        i = i + 1;
    }
    let s = 0;
    i = 0;
    while i < n {
        if let Option::Some(x) = m.get(i) {
            s = s + x.v;
        }
        i = i + 1;
    }
    let _ = print(format("%i %i", m.len(), s));
}
