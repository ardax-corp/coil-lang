// coil-stdlib's `text::ord` / `text::char` in Coil, once prelude natives.
// Needs `--root` with coil-stdlib's `src`.
// ITERS=2000000. Checksum 218999976.
use text::{char, ord};
use io::sync::print;
use string::format;

fn main() {
    let iters = 2000000;
    let acc = 0;
    let i = 0;
    while i < iters {
        let c = char(((i % 26) + 97) as byte)?;
        acc = acc + (ord(c)? as int);
        i = i + 1;
    }
    let _ = print(format("%i", acc));
}
