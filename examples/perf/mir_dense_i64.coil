// Hit bench for COI-288 W2: dense lowering of counted i64 +/− (no heap/CALL).
// Loops of i64 +/- must take the dense path like float ones.
// Trip count is a parameter so the loop is not a const-unroll candidate.
use io::sync::print;
use string::format;

fn hot(int a, int b, int n) -> int {
    let i = 0;
    let s = 0;
    while i < n {
        s = s + i + a - b;
        i = i + 1;
    }
    return s;
}

fn main() {
    let _ = print(format("%i", hot(2, 1, 2000000)));
}
