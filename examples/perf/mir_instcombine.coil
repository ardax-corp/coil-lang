// Hit bench for COI-281 MIR InstCombine: `t * 2.0` → `t + t`.
// Identities (`* 1.0`, `+ 0.0`) also fold when they survive.
use io::sync::print;
use string::format;

fn hot(float scale, int n) -> float {
    let i = 0;
    let s = 0.0;
    while i < n {
        let xf = (i as float) * scale;
        let t = xf * xf;
        s = ((s + t * 2.0) * 1.0) + 0.0;
        i = (i + 1) + 0;
    }
    return s;
}

fn main() {
    let _ = print(format("%i", hot(1.5, 1200000) as int));
}
