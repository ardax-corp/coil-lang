// Sum a coil int array via C `sum_array`. Expected output: `15`.
//
// @output (not checked: needs `--allow-dload sum`; see the example_ffi_* pipeline tests)

use io::sync::print;
use string::format;

extern "sum" {
    fn sum_array(Vec<int> arr, int n) -> int;
}

fn main() {
    let arr = [1, 2, 3, 4, 5];
    let _ = print(format("%i", sum_array(arr, 5)));
}
