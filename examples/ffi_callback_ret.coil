// examples/ffi_callback_ret.coil — a C function pointer returned as `ptr`.
//
// get_doubler() returns a C function pointer; taken as an `int`, it is its
// address.
//
// @output (not checked: needs `--allow-dload sum`; see the example_ffi_* pipeline tests)

use io::sync::print;
use string::format;

extern "sum" {
    fn get_doubler() -> int;
}

fn main() {
    // A non-null address: we got a real pointer back.
    if get_doubler() == 0 {
        let _ = print(format("%i", 0));
    } else {
        let _ = print(format("%i", 1));
    }
}
