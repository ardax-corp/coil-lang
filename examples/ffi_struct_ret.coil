// examples/ffi_struct_ret.coil — FFI struct return via make_point.
//
// @output (not checked: needs `--allow-dload sum`; see the example_ffi_* pipeline tests)

use io::sync::print;
use string::format;

extern struct Point {
    x: int32,
    y: int32,
};

// C takes `int32_t`; an `extern` parameter cannot be a sized integer yet
// (#2886), and the low 32 bits of an `int` register are what C reads.
extern "sum" {
    fn make_point(int x, int y) -> Point;
}

fn main() {
    let p = make_point(3, 4);
    let _ = print(format("%i", p.x));
    let _ = print(format("%i", p.y));
}
