// Helper module for tests/modules/readonly_trait_call_across_modules.coil
// (#2468): a trait, a class, the impl and a caller in one module that is not
// the program's.

class Tally {
    pub n: int,
}

trait Peek<T> {
    fn peek(T x, int v) -> int {}
    fn poke(T x, int v) -> int {}
}

impl Peek for Tally {
    pub fn peek(Tally x, int v) -> int {
        return x.n + v;
    }

    pub fn poke(Tally x, int v) -> int {
        x.n = x.n + v;
        return x.n;
    }
}

class Crate<T> {
    pub item: T,
    pub n: int,
}

impl Peek for Crate<T> {
    pub fn peek(Crate<T> x, int v) -> int {
        return x.n + v;
    }

    pub fn poke(Crate<T> x, int v) -> int {
        x.n = x.n + v;
        return x.n;
    }
}

fn store_peeks() -> int {
    let t = readonly new Tally(1);
    return Peek::peek(t, 2) + t.peek(3);
}
