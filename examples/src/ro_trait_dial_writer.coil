// Helper module for tests/modules/readonly_trait_call_across_modules.coil
// (#2468): another class named `Dial`, whose `Gauge::level` writes. Nothing
// it does says what `ro_trait_dial::Dial`'s `level` mutates.

use ro_trait_gauge::Gauge;

class Dial {
    pub n: int,
}

impl Gauge for Dial {
    pub fn level(Dial x, int v) -> int {
        x.n = x.n + v;
        return x.n;
    }

    pub fn wind(Dial x, int v) -> int {
        x.n = x.n + v;
        return x.n;
    }
}

fn writer_reads() -> int {
    let d = new Dial(2);
    return Gauge::level(d, 2) + d.level(3);
}
