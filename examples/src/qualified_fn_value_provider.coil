// Helper for tests/functions/qualified_fn_value_call.coil: a `const`, a
// `static` and a class static field holding function values, called
// through their module path (#1705).

fn twice(int x) -> int {
    return x * 2;
}

fn add(int a, int b) -> int {
    return a + b;
}

fn seven() -> int {
    return 7;
}

const TWICE = twice;

const SEVEN = seven;

const ADD = add;

static let HOOK: fn(int) -> int = twice;

static let NOW: fn() -> int = seven;

class Ops {
    pub static triple: fn(int) -> int = fn (int x) => x * 3,
    pub static zero: fn() -> int = fn () => 0,
}

// Not a function: tests/functions/compile_fail/call_non_function_module_const.coil
// calls it and must be rejected (#1726).
const LIMIT = 10;
