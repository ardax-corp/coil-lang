// A generic class whose loop calls another module's generic class's method
// (`examples/perf/foreign_clone_callee.coil`, #2219).
use xm_cell::Cell;

/// Runs a loop over a cell.
class Drive<T> {
    pub cell: Cell<T>,
}

impl Drive<T> {
    /// The sum of the cell's totals over `n` bumps.
    pub fn run(int n) -> int {
        let s = 0;
        let i = 0;
        while i < n {
            s = s + self.cell.bump(i % 7);
            i = i + 1;
        }
        return s % 1000003;
    }
}
